---
import Arrow from '../components/Arrow.astro';
import '../styles/global.css';
import { languages, langs, pathFor, defaultLang, t, type Lang } from '../i18n';

interface Props {
  title: string;
  description?: string;
  /** 'wide': no content column, the page lays out its own sections on the wide grid */
  layout?: 'page' | 'wide';
  lang?: Lang;
}

const { title, description = 'EKHO Labs', layout = 'page', lang = defaultLang } = Astro.props;
const c = t(lang);
const year = new Date().getFullYear();
const wide = layout === 'wide';

// Until launch the site stays out of search engines (AGENTS.md §9).
// At launch: set this to true and restore the Sitemap line in public/robots.txt.
const indexable = false;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {/* every language points at every other, including itself, and x-default at
        the root, so a search engine is told which version is which rather than
        left to guess from the text */}
    {langs.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(pathFor(l), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* These two classes decide what the page looks like before anything moves:
        without them the graphic renders in its finished state, which is correct
        for a reader without JavaScript and wrong for everyone else, who saw the
        finished net for a frame before the opening took hold of it. Inline and
        in the head, so it is set before the first paint rather than whenever
        the module for the page happens to load. */}
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('reveal-on');
    </script>
  </head>
  <body>
    <header class="ekho-header">
      <div
        class:list={[
          'wrap',
          { 'wrap-wide': wide, 'ekho-header--centred': Astro.slots.has('header-nav') },
        ]}
      >
        {/* Home in the language being read. A bare "/" sent a reader of the
            German page to the English one, which is a strange thing for the
            wordmark to do. */}
        <a class="ekho-brand" href={pathFor(lang)}>
          EKHO
        </a>
        <slot name="header-nav">
          <nav class="ekho-links">
            <a href={pathFor(lang)}>Home</a>
            <a href="https://github.com/ekholabs">GitHub</a>
          </nav>
        </slot>
        {Astro.slots.has('header-nav') && (
          <div class="ekho-header__aside">
            {/* A plain select: it is the one control every platform already
                knows how to open, reach by keyboard and read out, and each
                option is a real URL, so it still works with the script off. */}
            <label class="ekho-lang">
              <span class="visually-hidden">{c.nav.language}</span>
              <select class="ekho-lang__select" data-lang-select>
                {langs.map((l) => (
                  <option value={pathFor(l)} selected={l === lang}>
                    {languages[l].short}
                  </option>
                ))}
              </select>
              <span class="ekho-lang__caret" aria-hidden="true">
                ⌄
              </span>
            </label>
            <a class="ekho-header__link" href="https://github.com/ekholabs">
              GitHub <Arrow />
            </a>
          </div>
        )}
        {Astro.slots.has('header-nav') && (
          <button
            class="ekho-burger"
            type="button"
            aria-expanded="false"
            aria-controls="chapter-nav"
            aria-label="Open menu"
            data-burger
          >
            <span class="ekho-burger__lines" aria-hidden="true"></span>
          </button>
        )}
      </div>
    </header>

    {wide ? (
      <main class="main-wide">
        <slot />
      </main>
    ) : (
      <main>
        <div class="wrap">
          <slot />
        </div>
      </main>
    )}

    <footer class="ekho-footer">
      <div class:list={['wrap', { 'wrap-wide': wide }]}>
        <span>&copy; {year} EKHO Labs</span>
        <nav class="ekho-footer__nav" aria-label="Legal">
          <a href="/imprint">Legal notice</a>
          <a href="/privacy">Privacy</a>
        </nav>
      </div>
    </footer>

    <script>
      // Narrow screens get a menu instead of a row of chapters. The panel is
      // the same <nav> the wide layout uses, laid out full screen by CSS, so
      // there is one list of links and not two. Without the script the button
      // is not rendered as interactive and the nav stays a plain list.
      const root = document.documentElement;
      const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
      const panel = document.getElementById('chapter-nav');

      if (burger && panel) {
        const set = (open: boolean) => {
          root.classList.toggle('menu-open', open);
          burger.setAttribute('aria-expanded', String(open));
          burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        };

        burger.addEventListener('click', () => set(!root.classList.contains('menu-open')));

        // following a link closes the menu, so the target is not hidden behind it
        panel.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) set(false);
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && root.classList.contains('menu-open')) {
            set(false);
            burger.focus();
          }
        });

        // widening past the breakpoint puts the chapters back in the header
        const wide = window.matchMedia('(min-width: 64rem)');
        wide.addEventListener('change', (e) => {
          if (e.matches) set(false);
        });
      }

      // the select carries the destination in its value, so choosing goes there
      const picker = document.querySelector<HTMLSelectElement>('[data-lang-select]');
      picker?.addEventListener('change', () => {
        window.location.pathname = picker.value;
      });
    </script>
  </body>
</html>
