---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** 'wide': no content column, the page lays out its own sections on the wide grid */
  layout?: 'page' | 'wide';
}

const { title, description = 'EKHO Labs', layout = 'page' } = Astro.props;
const year = new Date().getFullYear();
const wide = layout === 'wide';

// Until launch the site stays out of search engines (AGENTS.md §9).
// At launch: set this to true and restore the Sitemap line in public/robots.txt.
const indexable = false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div
        class:list={[
          'wrap',
          { 'wrap-wide': wide, 'header-centred': Astro.slots.has('header-nav') },
        ]}
      >
        <a class="brand" href="/">
          EKHO
        </a>
        <slot name="header-nav">
          <nav class="nav">
            <a href="/">Home</a>
            <a href="https://github.com/ekholabs">GitHub</a>
          </nav>
        </slot>
        {Astro.slots.has('header-nav') && (
          <a class="header-aside" href="https://github.com/ekholabs">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </header>

    {wide ? (
      <main class="main-wide">
        <slot />
      </main>
    ) : (
      <main>
        <div class="wrap">
          <slot />
        </div>
      </main>
    )}

    <footer class="site-footer">
      <div class:list={['wrap', { 'wrap-wide': wide }]}>
        <span>&copy; {year} EKHO Labs</span>
        <nav class="footer-nav" aria-label="Legal">
          <a href="/imprint">Legal notice</a>
          <a href="/privacy">Privacy</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
