---
// The companion graphic. One cloud of points, the same 64 throughout, three
// states, after the Figma choreography (file "EKHO CI · Vorschlag", pages 11
// and 13):
//
//   stage 1 (no class)  scattered    before EKHO, no form, nothing connected
//   stage 2 (.is-2)     connected    the same points find a form, first links
//   stage 3 (.is-3)     compounding  no new point, three times the links
//
// The layout is organic, not a lattice: points are Poisson-sampled inside a
// disc, so the form reads as a cloud that found an edge rather than a grid.
// Dots are small and the links are hairlines; the picture carries by density,
// never by weight.
//
// Without JavaScript every stage collapses to the finished graphic, so the
// figure still reads. animated={false} pins it to the finished state.

interface Props {
  animated?: boolean;
  idPrefix?: string;
  caption?: boolean;
}
const { animated = true, caption = true } = Astro.props;

const SIZE = 560;
const C = SIZE / 2;
const R = 232; // radius of the formed cloud
const DOT = 3.3; // the resting dot, small on purpose
const N = 64;

// deterministic: the same picture on every build, and the same as in Figma
function mulberry32(a: number) {
  return function () {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
function shuffled<T>(arr: T[], seed: number) {
  const r = mulberry32(seed);
  const out = arr.slice();
  for (let i = out.length - 1; i > 0; i--) {
    const j = Math.floor(r() * (i + 1));
    [out[i], out[j]] = [out[j], out[i]];
  }
  return out;
}

// stage 2 and 3: Poisson-sampled inside the disc. Dart throwing with a
// shrinking minimum distance, so the cloud fills evenly without a grid.
function sample(seed: number, radius: number, count: number, minDist: number) {
  const rnd = mulberry32(seed);
  const pts: [number, number][] = [];
  let d = minDist;
  let guard = 0;
  while (pts.length < count && guard++ < 40000) {
    const a = rnd() * Math.PI * 2;
    const r = radius * Math.sqrt(rnd());
    const p: [number, number] = [C + Math.cos(a) * r, C + Math.sin(a) * r];
    if (pts.every((q) => Math.hypot(q[0] - p[0], q[1] - p[1]) >= d)) pts.push(p);
    if (guard % 3000 === 0) d *= 0.92;
  }
  return pts.map((p) => [+p[0].toFixed(1), +p[1].toFixed(1)] as [number, number]);
}

const cloud = sample(7, R, N, 46);
const dist = (i: number, j: number) =>
  Math.hypot(cloud[i][0] - cloud[j][0], cloud[i][1] - cloud[j][1]);

// stage 1: the same count, spread loose, no form and no edge
const rs = mulberry32(41);
const scatter: [number, number][] = [];
for (let i = 0; i < N; i++) {
  scatter.push([+(46 + rs() * (SIZE - 92)).toFixed(1), +(58 + rs() * (SIZE - 116)).toFixed(1)]);
}
const sOrder = shuffled(
  scatter.map((_, i) => i),
  3,
);
const scatterTier = (i: number) => {
  const p = sOrder.indexOf(i);
  return p < 15 ? 'a' : p < 36 ? 'b' : 'c';
};

// stage 2: a few links across the cloud, at most two per point, most stay loose
const candidates: [number, number][] = [];
for (let i = 0; i < N; i++) {
  for (let j = i + 1; j < N; j++) {
    const d = dist(i, j);
    if (d > 44 && d < 132) candidates.push([i, j]);
  }
}
const deg2 = cloud.map(() => 0);
const links2: [number, number][] = [];
for (const [i, j] of shuffled(candidates, 211)) {
  if (links2.length >= 22) break;
  if (deg2[i] >= 2 || deg2[j] >= 2) continue;
  links2.push([i, j]);
  deg2[i]++;
  deg2[j]++;
}
const linked2 = new Set<number>();
links2.forEach(([a, b]) => {
  linked2.add(a);
  linked2.add(b);
});
const looseOrder = shuffled(
  cloud.map((_, i) => i).filter((i) => !linked2.has(i)),
  97,
);
const stage2Tier = (i: number) => {
  if (linked2.has(i)) return 't0';
  const p = looseOrder.indexOf(i);
  if (p < Math.ceil(looseOrder.length * 0.34)) return 't2';
  if (p < Math.ceil(looseOrder.length * 0.7)) return 't3';
  return 't4';
};

// stage 3: every point carries, plus a few links that cross the cloud
const seen = new Set<string>();
const links3: [number, number][] = [];
const key = (a: number, b: number) => (a < b ? `${a}-${b}` : `${b}-${a}`);
for (let i = 0; i < N; i++) {
  const near = cloud
    .map((_, j) => j)
    .filter((j) => j !== i && dist(i, j) <= 108)
    .sort((a, b) => dist(i, a) - dist(i, b))
    .slice(0, 3);
  for (const j of near) {
    const k = key(i, j);
    if (!seen.has(k)) {
      seen.add(k);
      links3.push([i, j]);
    }
  }
}
const rb = mulberry32(29);
for (let n = 0; n < 12; n++) {
  let a = Math.floor(rb() * N);
  let b = Math.floor(rb() * N);
  let guard = 0;
  while ((a === b || dist(a, b) < 150 || dist(a, b) > 330) && guard++ < 300) {
    a = Math.floor(rb() * N);
    b = Math.floor(rb() * N);
  }
  const k = key(a, b);
  if (!seen.has(k)) {
    seen.add(k);
    links3.push([a, b]);
  }
}
const deg3 = cloud.map(() => 0);
links3.forEach(([a, b]) => {
  deg3[a]++;
  deg3[b]++;
});
// what compounding looks like: the spread in size, not more points
const r3 = (i: number) => +(DOT * 0.82 + Math.min(deg3[i], 7) * 0.62).toFixed(2);

// a handful of points say what they are, on hover and on focus. Only out
// towards the edge, so the label has room and never covers the cloud.
const named: { at: [number, number]; type: string; title: string }[] = [
  { at: [206, 198], type: 'Person', title: 'Anna Berger' },
  { at: [212, 252], type: 'Meeting', title: 'The call on Thursday' },
  { at: [196, 306], type: 'Voice note', title: 'Tuesday, on the walk' },
  { at: [208, 20], type: 'Decision', title: 'The pilot moves to Q1' },
  { at: [200, 88], type: 'Principle', title: 'No start dates before the review' },
  { at: [150, 146], type: 'Insight', title: 'Context compounds when connected' },
  { at: [158, 44], type: 'Assumption', title: 'They will host it themselves' },
  { at: [164, 340], type: 'Article', title: 'The future of knowledge work' },
];
function nearestTo(radius: number, deg: number) {
  const t = [
    C + Math.cos((deg * Math.PI) / 180) * radius,
    C + Math.sin((deg * Math.PI) / 180) * radius,
  ];
  let best = 0;
  let bd = Infinity;
  cloud.forEach((p, i) => {
    const d = Math.hypot(p[0] - t[0], p[1] - t[1]);
    if (d < bd) {
      bd = d;
      best = i;
    }
  });
  return best;
}
const labels = new Map<number, { type: string; title: string }>();
for (const n of named) {
  const idx = nearestTo(n.at[0], n.at[1]);
  if (!labels.has(idx)) labels.set(idx, { type: n.type, title: n.title });
}

const path = (segs: [number, number][]) =>
  segs.map(([a, b]) => `M${cloud[a][0]} ${cloud[a][1]}L${cloud[b][0]} ${cloud[b][1]}`).join('');

const figureClass = ['context-graphic', animated ? '' : 'is-final'].filter(Boolean).join(' ');
const ariaLabel =
  'The same knowledge in three states: scattered and unconnected before EKHO, gathered into one form with the first connections, and finally densely connected without a single new point.';
---

<figure
  class={figureClass}
  data-graphic={animated ? '' : undefined}
  role="group"
  aria-label={ariaLabel}
>
  <svg viewBox={`0 0 ${SIZE} ${SIZE}`} aria-hidden="true">
    <!-- stage 1: no form -->
    <g class="cg-scatter">
      {scatter.map((p, i) => (
        <circle class={`cg-seed s-${scatterTier(i)}`} cx={p[0]} cy={p[1]} r={DOT} />
      ))}
    </g>

    <!-- stages 2 and 3: the cloud -->
    <g class="cg-grid">
      <path class="cg-link cg-link-2" d={path(links2)} />
      <path class="cg-link cg-link-3" d={path(links3)} />
      <g class="cg-dots">
        {cloud.map((p, i) => {
          const label = labels.get(i);
          const cls = ['cg-dot', stage2Tier(i)].join(' ');
          const big = r3(i);
          if (!label)
            return <circle class={cls} cx={p[0]} cy={p[1]} r={DOT} style={`--r3:${big}px`} />;
          const right = p[0] >= C;
          const lx = right ? p[0] + 16 : p[0] - 16;
          return (
            <g
              class="cg-pt"
              tabindex="0"
              role="img"
              aria-label={`${label.type}: ${label.title}`}
              data-side={right ? 'right' : 'left'}
            >
              <title>{`${label.type}: ${label.title}`}</title>
              <circle class="cg-halo" cx={p[0]} cy={p[1]} r={11} />
              <circle class={cls} cx={p[0]} cy={p[1]} r={DOT} style={`--r3:${big}px`} />
              <g class="cg-tip">
                <line
                  class="cg-tip-tick"
                  x1={right ? p[0] + 7 : p[0] - 7}
                  y1={p[1]}
                  x2={lx - (right ? 3 : -3)}
                  y2={p[1]}
                />
                <text class="cg-tip-type" x={lx} y={p[1] - 6} text-anchor={right ? 'start' : 'end'}>
                  {label.type}
                </text>
                <text
                  class="cg-tip-title"
                  x={lx}
                  y={p[1] + 12}
                  text-anchor={right ? 'start' : 'end'}
                >
                  {label.title}
                </text>
              </g>
              <circle class="cg-hit" cx={p[0]} cy={p[1]} r={15} />
            </g>
          );
        })}
      </g>
    </g>
  </svg>

  {caption && (
    <figcaption class="cg-caption">
      <span class="cg-caption-1">Before EKHO: it is all there, none of it connected.</span>
      <span class="cg-caption-2">
        With EKHO: the same knowledge, in one form. The first links form.
      </span>
      <span class="cg-caption-3">
        It compounds: not one new point, three times the connections.
      </span>
    </figcaption>
  )}
</figure>
