---
// The graphic that builds up alongside the chapters, after the Braun speaker
// grille: one form, the same 64 points throughout, only the connections grow.
//
//   stage 1 (no class)  scattered   before EKHO, no form, nothing connected
//   stage 2 (.is-2)     connected   the same points in one form, first links
//   stage 3 (.is-3/4)   compounding no new points, three times the links
//
// Without JavaScript every stage collapses to the finished graphic, so the
// figure still reads. animated={false} pins it to the finished state for the
// overview tile. idPrefix keeps ids unique when it appears more than once.

interface Props {
  animated?: boolean;
  idPrefix?: string;
  caption?: boolean;
}
const { animated = true, idPrefix = 'cg', caption = true } = Astro.props;

const SIZE = 560;
const C = SIZE / 2;
const RING = 52;
const R_MAX = 208;
const DOT = 6.4;

// deterministic: the same picture on every build, and the same as in Figma
function mulberry32(a: number) {
  return function () {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
function shuffled<T>(arr: T[], seed: number) {
  const r = mulberry32(seed);
  const out = arr.slice();
  for (let i = out.length - 1; i > 0; i--) {
    const j = Math.floor(r() * (i + 1));
    [out[i], out[j]] = [out[j], out[i]];
  }
  return out;
}

// the grille: concentric rings, even spacing, one hole size
const lattice: [number, number][] = [[C, C]];
for (let r = RING; r <= R_MAX; r += RING) {
  const n = Math.round((2 * Math.PI * r) / RING);
  const off = (r / RING) % 2 ? 0 : Math.PI / n;
  for (let i = 0; i < n; i++) {
    const a = off + (i * 2 * Math.PI) / n;
    lattice.push([+(C + Math.cos(a) * r).toFixed(1), +(C + Math.sin(a) * r).toFixed(1)]);
  }
}
const N = lattice.length;
const dist = (i: number, j: number) =>
  Math.hypot(lattice[i][0] - lattice[j][0], lattice[i][1] - lattice[j][1]);

// stage 1: the same count, no form
const rs = mulberry32(41);
const scatter: [number, number][] = [];
for (let i = 0; i < N; i++) {
  scatter.push([Math.round(64 + rs() * 432), Math.round(64 + rs() * 432)]);
}
const sOrder = shuffled(
  scatter.map((_, i) => i),
  3,
);
const scatterTier = (i: number) => {
  const p = sOrder.indexOf(i);
  return p < 14 ? 'a' : p < 34 ? 'b' : 'c';
};

// stage 2: a few chords across the grid, at most two per point, most stay loose
const candidates: [number, number][] = [];
for (let i = 0; i < N; i++) {
  for (let j = i + 1; j < N; j++) {
    const d = dist(i, j);
    if (d > RING * 1.15 && d < RING * 2.9) candidates.push([i, j]);
  }
}
const deg2 = lattice.map(() => 0);
const links2: [number, number][] = [];
for (const [i, j] of shuffled(candidates, 211)) {
  if (links2.length >= 21) break;
  if (deg2[i] >= 2 || deg2[j] >= 2) continue;
  links2.push([i, j]);
  deg2[i]++;
  deg2[j]++;
}
const linked2 = new Set<number>();
links2.forEach(([a, b]) => {
  linked2.add(a);
  linked2.add(b);
});
const looseOrder = shuffled(
  lattice.map((_, i) => i).filter((i) => !linked2.has(i)),
  97,
);
const linkedOrder = shuffled([...linked2], 53);
const stage2Tier = (i: number) => {
  if (linked2.has(i))
    return linkedOrder.indexOf(i) < Math.round(linkedOrder.length * 0.7) ? 't0' : 't1';
  const p = looseOrder.indexOf(i);
  if (p < Math.ceil(looseOrder.length * 0.3)) return 't2';
  if (p < Math.ceil(looseOrder.length * 0.65)) return 't3';
  return 't4';
};

// stage 3: every point carries, plus a few links that jump rings
const seen = new Set<string>();
const links3: [number, number][] = [];
const key = (a: number, b: number) => (a < b ? `${a}-${b}` : `${b}-${a}`);
for (let i = 0; i < N; i++) {
  const near = lattice
    .map((_, j) => j)
    .filter((j) => j !== i && dist(i, j) <= RING * 2.0)
    .sort((a, b) => dist(i, a) - dist(i, b))
    .slice(0, 3);
  for (const j of near) {
    const k = key(i, j);
    if (!seen.has(k)) {
      seen.add(k);
      links3.push([i, j]);
    }
  }
}
const rb = mulberry32(29);
for (let n = 0; n < 10; n++) {
  let a = Math.floor(rb() * N);
  let b = Math.floor(rb() * N);
  let guard = 0;
  while ((a === b || dist(a, b) < RING * 2.2 || dist(a, b) > RING * 4.6) && guard++ < 200) {
    a = Math.floor(rb() * N);
    b = Math.floor(rb() * N);
  }
  const k = key(a, b);
  if (!seen.has(k)) {
    seen.add(k);
    links3.push([a, b]);
  }
}
const deg3 = lattice.map(() => 0);
links3.forEach(([a, b]) => {
  deg3[a]++;
  deg3[b]++;
});
const hubs: number[] = [];
for (const [, i] of deg3.map((d, i) => [d, i] as [number, number]).sort((a, b) => b[0] - a[0])) {
  if (hubs.length >= 5) break;
  if (hubs.every((h) => dist(h, i) >= 120)) hubs.push(i);
}

// a handful of points say what they are. Only on the outer rings, so the label
// has room and never covers the disc.
const named: { at: [number, number]; type: string; title: string }[] = [
  { at: [208, 200], type: 'Meeting', title: 'Call with Anna' },
  { at: [208, 310], type: 'Web research', title: 'Context platforms, 2026' },
  { at: [156, 250], type: 'Voice note', title: 'Tuesday, on the walk' },
  { at: [208, 20], type: 'Decision', title: 'Pilot moves to Q1' },
  { at: [208, 95], type: 'Principle', title: 'No start dates before the review' },
  { at: [156, 55], type: 'Article', title: 'The future of knowledge work' },
  { at: [156, 150], type: 'Insight', title: 'Context compounds when connected' },
];
function nearestTo(radius: number, deg: number) {
  const t = [
    C + Math.cos((deg * Math.PI) / 180) * radius,
    C + Math.sin((deg * Math.PI) / 180) * radius,
  ];
  let best = 0;
  let bd = Infinity;
  lattice.forEach((p, i) => {
    const d = Math.hypot(p[0] - t[0], p[1] - t[1]);
    if (d < bd) {
      bd = d;
      best = i;
    }
  });
  return best;
}
const labels = new Map<number, { type: string; title: string }>();
for (const n of named) {
  const idx = nearestTo(n.at[0], n.at[1]);
  if (!labels.has(idx)) labels.set(idx, { type: n.type, title: n.title });
}

const path = (segs: [number, number][]) =>
  segs
    .map(([a, b]) => `M${lattice[a][0]} ${lattice[a][1]}L${lattice[b][0]} ${lattice[b][1]}`)
    .join('');

const figureClass = ['context-graphic', animated ? '' : 'is-final'].filter(Boolean).join(' ');
const ariaLabel =
  'The same knowledge in three states: scattered and unconnected before EKHO, brought into one form with first connections, and finally densely connected without a single new point.';
---

<figure
  class={figureClass}
  data-graphic={animated ? '' : undefined}
  role="group"
  aria-label={ariaLabel}
>
  <svg viewBox={`0 0 ${SIZE} ${SIZE}`} aria-hidden="true">
    <!-- stage 1: no form -->
    <g class="cg-scatter">
      {scatter.map((p, i) => (
        <circle class={`cg-seed s-${scatterTier(i)}`} cx={p[0]} cy={p[1]} r={DOT} />
      ))}
    </g>

    <!-- stages 2 and 3: the grille -->
    <g class="cg-grid">
      <path class="cg-link cg-link-2" d={path(links2)} />
      <path class="cg-link cg-link-3" d={path(links3)} />
      <g class="cg-dots">
        {lattice.map((p, i) => {
          const label = labels.get(i);
          const cls = ['cg-dot', stage2Tier(i), hubs.includes(i) ? 'is-hub' : '']
            .filter(Boolean)
            .join(' ');
          if (!label) return <circle class={cls} cx={p[0]} cy={p[1]} r={DOT} />;
          const right = p[0] >= C;
          const lx = right ? p[0] + 18 : p[0] - 18;
          return (
            <g
              class="cg-pt"
              tabindex="0"
              role="img"
              aria-label={`${label.type}: ${label.title}`}
              data-side={right ? 'right' : 'left'}
            >
              <title>{`${label.type}: ${label.title}`}</title>
              <circle class="cg-halo" cx={p[0]} cy={p[1]} r={13} />
              <circle class={cls} cx={p[0]} cy={p[1]} r={DOT} />
              <g class="cg-tip">
                <line
                  class="cg-tip-tick"
                  x1={right ? p[0] + 9 : p[0] - 9}
                  y1={p[1]}
                  x2={lx - (right ? 4 : -4)}
                  y2={p[1]}
                />
                <text class="cg-tip-type" x={lx} y={p[1] - 7} text-anchor={right ? 'start' : 'end'}>
                  {label.type}
                </text>
                <text
                  class="cg-tip-title"
                  x={lx}
                  y={p[1] + 13}
                  text-anchor={right ? 'start' : 'end'}
                >
                  {label.title}
                </text>
              </g>
              <circle class="cg-hit" cx={p[0]} cy={p[1]} r={17} />
            </g>
          );
        })}
      </g>
    </g>
  </svg>

  {caption && (
    <figcaption class="cg-caption">
      <span class="cg-caption-1">Before EKHO: it is all there, none of it connected.</span>
      <span class="cg-caption-2">
        With EKHO: the same knowledge, in one form. The first links form.
      </span>
      <span class="cg-caption-3">
        It compounds: not one new point, three times the connections.
      </span>
    </figcaption>
  )}
</figure>
