---
// The graphic that builds up alongside the chapters. Stage classes on the
// figure (is-2 … is-4) switch its parts on; without JavaScript every part is
// shown, so the graphic reads as finished. With animated={false} it is always
// shown finished (the overview tile). idPrefix keeps the SVG ids unique when
// the graphic appears more than once on a page.

interface Props {
  animated?: boolean;
  idPrefix?: string;
  caption?: boolean;
}
const { animated = true, idPrefix = 'cg', caption = true } = Astro.props;
const tileId = `${idPrefix}-tile`;
const hatchId = `${idPrefix}-hatch`;

const icons: Record<string, string> = {
  meeting:
    '<circle cx="9" cy="8" r="3.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.5"/><path d="M16 14.2c2.8.3 5 2.6 5 5.8"/>',
  article: '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/><path d="M9 12h6M9 16h6"/>',
  voice: '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  decision: '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="m8.5 12 2.5 2.5 5-5"/>',
  person: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/>',
  terminal: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 9 3 3-3 3M12 15h5"/>',
};

const sources = [
  { label: 'Meeting', icon: 'meeting', x: 80 },
  { label: 'Article', icon: 'article', x: 200 },
  { label: 'Voice note', icon: 'voice', x: 320 },
  { label: 'Mail', icon: 'mail', x: 440 },
  { label: 'Decision', icon: 'decision', x: 560 },
];

const readers = [
  { label: 'You', icon: 'person', x: 110 },
  { label: 'Codex', icon: 'terminal', x: 250 },
  { label: 'OpenCode', icon: 'terminal', x: 390 },
  { label: 'Any agent', icon: 'terminal', x: 530 },
];

const tile = 72;
const top = 60;
const cx = 320;
const cTop = 250;
const cSize = 150;
const bottom = 520;

// a small graph inside the centre: nodes and the links that form in stage 2
const nodes = [
  [290, 292],
  [345, 285],
  [322, 318],
  [282, 338],
  [356, 334],
];
const edges = [
  [0, 1],
  [0, 2],
  [1, 2],
  [2, 3],
  [2, 4],
  [1, 4],
];
---

<figure
  class="context-graphic"
  data-graphic={animated ? '' : undefined}
  role="img"
  aria-label="What you bring in (meetings, articles, voice notes, mails, decisions) links into one connected context that is yours; you and your AI agents read from the same source."
>
  <svg viewBox="0 0 640 660" aria-hidden="true">
    <defs>
      <linearGradient id={tileId} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color: var(--tile-top)"></stop>
        <stop offset="1" style="stop-color: var(--tile-bottom)"></stop>
      </linearGradient>
      <pattern
        id={hatchId}
        width="10"
        height="10"
        patternUnits="userSpaceOnUse"
        patternTransform="rotate(45)"
      >
        <rect width="10" height="10" style="fill: var(--surface)"></rect>
        <rect width="5" height="10" style="fill: var(--stripe)"></rect>
      </pattern>
    </defs>

    <!-- lines: sources into the centre (stage 2), centre out to the readers (stage 3) -->
    <g class="cg-lines cg-in">
      {sources.map((s) => (
        <path
          pathLength="1"
          d={`M ${s.x} ${top + tile} C ${s.x} ${top + tile + 70}, ${cx} ${cTop - 80}, ${cx} ${cTop}`}
        />
      ))}
    </g>
    <g class="cg-lines cg-out">
      {readers.map((r) => (
        <path
          pathLength="1"
          d={`M ${cx} ${cTop + cSize} C ${cx} ${cTop + cSize + 60}, ${r.x} ${bottom - 60}, ${r.x} ${bottom}`}
        />
      ))}
    </g>

    <!-- sources -->
    <g class="cg-sources">
      {sources.map((s) => (
        <g transform={`translate(${s.x - tile / 2} ${top})`}>
          <text class="cg-label" x={tile / 2} y="-14" text-anchor="middle">
            {s.label}
          </text>
          <rect class="cg-tile" width={tile} height={tile} rx="10" fill={`url(#${tileId})`} />
          <svg class="cg-icon" x="24" y="24" width="24" height="24" viewBox="0 0 24 24">
            <g set:html={icons[s.icon]} />
          </svg>
        </g>
      ))}
    </g>

    <!-- centre: your context -->
    <g class="cg-center" transform={`translate(${cx - cSize / 2} ${cTop})`}>
      <rect
        class="cg-center-box"
        width={cSize}
        height={cSize}
        rx="14"
        fill={`url(#${tileId})`}
      ></rect>
      <rect
        class="cg-center-hatch"
        width={cSize}
        height={cSize}
        rx="14"
        fill={`url(#${hatchId})`}
      ></rect>
    </g>
    <g class="cg-graph">
      {edges.map(([a, b]) => (
        <line
          class="cg-edge"
          pathLength="1"
          x1={nodes[a][0]}
          y1={nodes[a][1]}
          x2={nodes[b][0]}
          y2={nodes[b][1]}
        />
      ))}
      {nodes.map(([x, y]) => (
        <circle class="cg-node" cx={x} cy={y} r="5" />
      ))}
    </g>
    <text class="cg-center-label" x={cx} y={cTop + cSize - 22} text-anchor="middle">
      Your context
    </text>

    <!-- readers -->
    <g class="cg-readers">
      {readers.map((r) => (
        <g transform={`translate(${r.x - tile / 2} ${bottom})`}>
          <rect class="cg-tile" width={tile} height={tile} rx="10" fill={`url(#${tileId})`} />
          <svg class="cg-icon" x="24" y="24" width="24" height="24" viewBox="0 0 24 24">
            <g set:html={icons[r.icon]} />
          </svg>
          <text class="cg-label" x={tile / 2} y={tile + 26} text-anchor="middle">
            {r.label}
          </text>
        </g>
      ))}
    </g>
  </svg>
  {caption && (
    <figcaption class="cg-caption">
      <span class="cg-caption-2">You bring things in. EKHO links them into one context.</span>
      <span class="cg-caption-3">You and your agents read the same files.</span>
      <span class="cg-caption-4">The context is yours. The model is replaceable.</span>
    </figcaption>
  )}
</figure>
