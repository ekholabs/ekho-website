---
// The companion graphic. One set of points for the whole page, moved between
// four states rather than cross-faded between four pictures, so the reader
// watches the same knowledge settle:
//
//   stage 0 (no class)  field        the hero. More points, spread wide, all
//                                    one grey. Nothing has a place yet
//   stage 1 (.is-1)     scattered    the extra points go, the rest draw in
//   stage 2 (.is-2)     connected    the points find a form, first links
//   stage 3 (.is-3)     compounding  no new point, three times the links
//
// Every dot is drawn once, at its scattered position, and the other two states
// are a CSS translate away. The transform carries the movement, so the browser
// animates it on the compositor and nothing is redrawn per frame.
//
// Without JavaScript the graphic rests in the finished state, which reads on
// its own. animated={false} pins it there.

interface Props {
  animated?: boolean;
  caption?: boolean;
}
const { animated = true, caption = true } = Astro.props;

const SIZE = 560;
const C = SIZE / 2;
const R = 232; // radius of the formed cloud
const DOT = 3.3;
const N = 64; // points that carry through every state
const EXTRA = 52; // points that exist only in the hero

function mulberry32(a: number) {
  return function () {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
function shuffled<T>(arr: T[], seed: number) {
  const r = mulberry32(seed);
  const out = arr.slice();
  for (let i = out.length - 1; i > 0; i--) {
    const j = Math.floor(r() * (i + 1));
    [out[i], out[j]] = [out[j], out[i]];
  }
  return out;
}
type P = [number, number];
const round = (p: P): P => [+p[0].toFixed(1), +p[1].toFixed(1)];

// dart throwing with a shrinking minimum distance: fills evenly, reads organic
function sample(seed: number, count: number, minDist: number, place: (r: () => number) => P) {
  const rnd = mulberry32(seed);
  const pts: P[] = [];
  let d = minDist;
  let guard = 0;
  while (pts.length < count && guard++ < 80000) {
    const p = place(rnd);
    if (pts.every((q) => Math.hypot(q[0] - p[0], q[1] - p[1]) >= d)) pts.push(p);
    if (guard % 4000 === 0) d *= 0.93;
  }
  return pts.map(round);
}

// stage 0: the hero. More points than anywhere else, spread over the whole
// frame rather than gathered, and every one the same grey.
const field = sample(19, N + EXTRA, 34, (r) => [24 + r() * (SIZE - 48), 24 + r() * (SIZE - 48)]);

// stage 1: loose, still formless, but pulled in from the edges
const scatter = sample(41, N, 42, (r) => [62 + r() * (SIZE - 124), 70 + r() * (SIZE - 140)]);

// stage 2 and 3: the cloud, Poisson-sampled inside a disc
const cloud = sample(7, N, 46, (r) => {
  const a = r() * Math.PI * 2;
  const rad = R * Math.sqrt(r());
  return [C + Math.cos(a) * rad, C + Math.sin(a) * rad];
});

// which field point becomes which scattered point. Nearest first, so the hero
// settles by contracting rather than by shuffling everything past everything.
const takenField = new Set<number>();
const origin: P[] = scatter.map((s) => {
  let best = -1;
  let bd = Infinity;
  field.forEach((f, i) => {
    if (takenField.has(i)) return;
    const d = Math.hypot(f[0] - s[0], f[1] - s[1]);
    if (d < bd) {
      bd = d;
      best = i;
    }
  });
  takenField.add(best);
  return field[best];
});
// everything the hero has on top of that leaves when the first chapter starts
const extras = field.filter((_, i) => !takenField.has(i));
const extraOrder = shuffled(
  extras.map((_, i) => i),
  5,
);

const dist = (i: number, j: number) =>
  Math.hypot(cloud[i][0] - cloud[j][0], cloud[i][1] - cloud[j][1]);

const sOrder = shuffled(
  scatter.map((_, i) => i),
  3,
);
const scatterTier = (i: number) => {
  const p = sOrder.indexOf(i);
  return p < 15 ? 'a' : p < 36 ? 'b' : 'c';
};

// stage 2: a few links across the cloud, at most two per point
const candidates: P[] = [];
for (let i = 0; i < N; i++) {
  for (let j = i + 1; j < N; j++) {
    const d = dist(i, j);
    if (d > 44 && d < 132) candidates.push([i, j]);
  }
}
const deg2 = cloud.map(() => 0);
const links2: P[] = [];
for (const [i, j] of shuffled(candidates, 211)) {
  if (links2.length >= 22) break;
  if (deg2[i] >= 2 || deg2[j] >= 2) continue;
  links2.push([i, j]);
  deg2[i]++;
  deg2[j]++;
}
const linked2 = new Set<number>();
links2.forEach(([a, b]) => {
  linked2.add(a);
  linked2.add(b);
});
const looseOrder = shuffled(
  cloud.map((_, i) => i).filter((i) => !linked2.has(i)),
  97,
);
const stage2Tier = (i: number) => {
  if (linked2.has(i)) return 't0';
  const p = looseOrder.indexOf(i);
  if (p < Math.ceil(looseOrder.length * 0.34)) return 't2';
  if (p < Math.ceil(looseOrder.length * 0.7)) return 't3';
  return 't4';
};

// stage 3: every point carries, plus a few links that cross the cloud
const seen = new Set<string>();
const links3: P[] = [];
const key = (a: number, b: number) => (a < b ? `${a}-${b}` : `${b}-${a}`);
for (let i = 0; i < N; i++) {
  const near = cloud
    .map((_, j) => j)
    .filter((j) => j !== i && dist(i, j) <= 108)
    .sort((a, b) => dist(i, a) - dist(i, b))
    .slice(0, 3);
  for (const j of near) {
    const k = key(i, j);
    if (!seen.has(k)) {
      seen.add(k);
      links3.push([i, j]);
    }
  }
}
const rb = mulberry32(29);
for (let n = 0; n < 12; n++) {
  let a = Math.floor(rb() * N);
  let b = Math.floor(rb() * N);
  let guard = 0;
  while ((a === b || dist(a, b) < 150 || dist(a, b) > 330) && guard++ < 300) {
    a = Math.floor(rb() * N);
    b = Math.floor(rb() * N);
  }
  const k = key(a, b);
  if (!seen.has(k)) {
    seen.add(k);
    links3.push([a, b]);
  }
}
const deg3 = cloud.map(() => 0);
links3.forEach(([a, b]) => {
  deg3[a]++;
  deg3[b]++;
});
const r3 = (i: number) => +(DOT * 0.82 + Math.min(deg3[i], 7) * 0.62).toFixed(2);

// a handful of points say what they are. In the scattered chapter they come in
// one after another by themselves; everywhere else they answer to hover and focus.
//
// Which dot carries which label is worked out, not hand-placed: each label is
// given a rough corner to sit in, and the nearest dot that can actually hold the
// text without running out of the frame, and without crowding a label already
// placed, takes it. That way the text can change without labels falling off.
const named: { at: P; type: string; title: string }[] = [
  { at: [206, 198], type: 'Person', title: 'Anna Berger' },
  { at: [212, 252], type: 'Meeting', title: 'The call on Thursday' },
  { at: [196, 306], type: 'Voice note', title: 'Tuesday, on the walk' },
  { at: [208, 20], type: 'Decision', title: 'The pilot moves to Q1' },
  { at: [200, 88], type: 'Principle', title: 'No start dates before the review' },
  { at: [150, 146], type: 'Insight', title: 'Context compounds when connected' },
  { at: [158, 44], type: 'Assumption', title: 'They will host it themselves' },
  { at: [164, 340], type: 'Article', title: 'The future of knowledge work' },
];

const PAD = 8; // how close a label may come to the edge of the frame
const GAP = 11; // between the dot and its text
// the widest the two lines get. Title at 12px, type at 9px with wide tracking.
const textWidth = (n: { type: string; title: string }) =>
  Math.max(n.title.length * 6.15, n.type.length * 6.3 + 4);

type Box = { x: number; y: number; r: number; b: number };
const box = (x: number, y: number, w: number, side: 'l' | 'r'): Box => ({
  x: side === 'r' ? x + GAP : x - GAP - w,
  r: side === 'r' ? x + GAP + w : x - GAP,
  y: y - 15,
  b: y + 17,
});
const hits = (a: Box, b: Box) => a.x < b.r + 6 && b.x < a.r + 6 && a.y < b.b + 4 && b.y < a.b + 4;

const placed: Box[] = [];
const labels = new Map<number, { type: string; title: string; side: 'l' | 'r' }>();

for (const n of named) {
  const target: P = [
    C + Math.cos((n.at[1] * Math.PI) / 180) * n.at[0],
    C + Math.sin((n.at[1] * Math.PI) / 180) * n.at[0],
  ];
  const w = textWidth(n);
  const order = scatter
    .map((p, i) => ({ i, p, d: Math.hypot(p[0] - target[0], p[1] - target[1]) }))
    .sort((a, b) => a.d - b.d);

  for (const cand of order) {
    if (labels.has(cand.i)) continue;
    const [x, y] = cand.p;
    // the two lines sit above and below the dot, so both need room
    if (y < PAD + 14 || y > SIZE - PAD - 16) continue;
    // the text leaves the cloud: prefer the side that points away from the middle
    const sides: ('l' | 'r')[] = x >= C ? ['r', 'l'] : ['l', 'r'];
    const side = sides.find((sd) => {
      const fits = sd === 'r' ? x + GAP + w <= SIZE - PAD : x - GAP - w >= PAD;
      // a label must not land on top of one already placed
      return fits && !placed.some((q) => hits(box(x, y, w, sd), q));
    });
    if (!side) continue;

    labels.set(cand.i, { type: n.type, title: n.title, side });
    placed.push(box(x, y, w, side));
    break;
  }
}

// the labels come in one after another, top to bottom of the scattered field
const labelOrder = new Map(
  [...labels.keys()].sort((a, b) => scatter[a][1] - scatter[b][1]).map((i, n) => [i, n]),
);

// every dot is drawn at its scattered position; the other states are a shift
const shift = (i: number) =>
  [
    `--dx0:${(origin[i][0] - scatter[i][0]).toFixed(1)}px`,
    `--dy0:${(origin[i][1] - scatter[i][1]).toFixed(1)}px`,
    `--dx2:${(cloud[i][0] - scatter[i][0]).toFixed(1)}px`,
    `--dy2:${(cloud[i][1] - scatter[i][1]).toFixed(1)}px`,
    `--r3:${r3(i)}px`,
  ].join(';');

const path = (segs: P[]) =>
  segs.map(([a, b]) => `M${cloud[a][0]} ${cloud[a][1]}L${cloud[b][0]} ${cloud[b][1]}`).join('');

const figureClass = ['context-graphic', animated ? '' : 'is-final'].filter(Boolean).join(' ');
const ariaLabel =
  'The same knowledge in four states: spread wide and formless at first, then scattered, then gathered into one form with the first connections, and finally densely connected without a single new point.';
---

<figure
  class={figureClass}
  data-graphic={animated ? '' : undefined}
  role="group"
  aria-label={ariaLabel}
>
  <svg viewBox={`0 0 ${SIZE} ${SIZE}`} aria-hidden="true">
    <!-- what the hero has on top: it leaves when the first chapter starts -->
    <g class="cg-extra">
      {extras.map((p, i) => (
        <circle
          class="cg-seed"
          cx={p[0]}
          cy={p[1]}
          r={DOT}
          style={`--i:${extraOrder.indexOf(i)}`}
        />
      ))}
    </g>

    <path class="cg-link cg-link-2" d={path(links2)} />
    <path class="cg-link cg-link-3" d={path(links3)} />

    <g class="cg-dots">
      {scatter.map((p, i) => {
        const label = labels.get(i);
        const cls = ['cg-dot', `s-${scatterTier(i)}`, stage2Tier(i)].join(' ');
        if (!label) return <circle class={cls} cx={p[0]} cy={p[1]} r={DOT} style={shift(i)} />;
        const right = label.side === 'r';
        const lx = right ? p[0] + 11 : p[0] - 11;
        return (
          <g
            class="cg-pt"
            style={`${shift(i)};--n:${labelOrder.get(i)}`}
            tabindex="0"
            role="img"
            aria-label={`${label.type}: ${label.title}`}
          >
            <title>{`${label.type}: ${label.title}`}</title>
            <circle class="cg-halo" cx={p[0]} cy={p[1]} r={11} />
            <circle class={cls} cx={p[0]} cy={p[1]} r={DOT} />
            <g class="cg-tip">
              <text class="cg-tip-type" x={lx} y={p[1] - 5} text-anchor={right ? 'start' : 'end'}>
                {label.type}
              </text>
              <text class="cg-tip-title" x={lx} y={p[1] + 12} text-anchor={right ? 'start' : 'end'}>
                {label.title}
              </text>
            </g>
            <circle class="cg-hit" cx={p[0]} cy={p[1]} r={15} />
          </g>
        );
      })}
    </g>
  </svg>

  {caption && (
    <figcaption class="cg-caption">
      <span class="cg-caption-1">Before EKHO: it is all there, none of it connected.</span>
      <span class="cg-caption-2">
        With EKHO: the same knowledge, in one form. The first links form.
      </span>
      <span class="cg-caption-3">
        It compounds: not one new point, three times the connections.
      </span>
    </figcaption>
  )}
</figure>
