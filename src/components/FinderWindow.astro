---
// A vault is a folder. The fastest way to say that is to show the folder the
// way the reader already sees folders. After the Figma frame "What · Ordner
// über Graph": one plain list, real macOS folder icons, floating over the
// graph, so the same knowledge is a picture and a directory at once.
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);

const folders = ['00 - Now', '01 - Projects', '02 - Areas', '03 - Resources', '04 - Archive'];
const files = ['AGENTS.md', 'index.md', 'log.md'];
---

<figure
  class="ekho-window ekho-window--glass ekho-window--finder"
  style="position: relative"
  aria-label="A vault is an ordinary folder: myEKHO in Finder"
>
  <div class="ekho-window__bar">
    <span class="ekho-window__lights" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span class="ekho-window__title">{c.finder.title}</span>
  </div>
  <ul class="fin-list" aria-hidden="true">
    {folders.map((f) => (
      <li>
        <svg class="ic-folder" viewBox="0 0 18 14" aria-hidden="true">
          <defs>
            <linearGradient id="folder-front" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#8ed2f8"></stop>
              <stop offset="1" stop-color="#4ca6e8"></stop>
            </linearGradient>
          </defs>
          <path
            d="M1 2.6A1.6 1.6 0 0 1 2.6 1h3.6c.4 0 .8.15 1.1.43L8.4 2.5H15.4A1.6 1.6 0 0 1 17 4.1v6.9a1.6 1.6 0 0 1-1.6 1.6H2.6A1.6 1.6 0 0 1 1 11z"
            fill="#3f9adf"
          ></path>
          <path
            d="M1 4.9h16v6.1A1.6 1.6 0 0 1 15.4 12.6H2.6A1.6 1.6 0 0 1 1 11z"
            fill="url(#folder-front)"
          ></path>
        </svg>
        {f}
      </li>
    ))}
    {files.map((f) => (
      <li class="is-file">
        <svg class="ic-doc" viewBox="0 0 14 17" aria-hidden="true">
          <path
            d="M1 1.8A.8.8 0 0 1 1.8 1H8.6L13 5.3V15.2a.8.8 0 0 1-.8.8H1.8a.8.8 0 0 1-.8-.8z"
            fill="#e8e5df"
          ></path>
          <path d="M8.6 1 13 5.3H9.4a.8.8 0 0 1-.8-.8z" fill="#cfcac1"></path>
        </svg>
        {f}
      </li>
    ))}
  </ul>
</figure>
