---
// A vault is a folder. The fastest way to say that is to show the folder the
// way the reader already sees folders: Finder, column view, real PARA names.
// Static by design, it is a picture of a filesystem and not a file browser.
const sidebar = [
  { group: 'Favourites', items: ['Desktop', 'Documents', 'Downloads'] },
  { group: 'Vaults', items: ['EKHO_brain', 'myEKHO', 'family'] },
];
const folders = ['00 - Now', '01 - Projects', '02 - Areas', '03 - Resources', '04 - Archive'];
const files = ['AGENTS.md', 'index.md', 'log.md'];
const inner = ['Decisions', 'Insights', 'Hypotheses', 'Principles', 'Contacts'];
const notes = [
  'adr-0027-braun-formensprache.md',
  'i-0147-compute-privacy.md',
  'p-0001-clarity-over-automation.md',
];
---

<figure
  class="win win--finder"
  aria-label="A vault is an ordinary folder: the EKHO_brain vault in Finder"
>
  <div class="win-bar">
    <span class="win-lights" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span class="win-title">EKHO_brain</span>
  </div>
  <div class="win-body">
    <nav class="fin-side" aria-hidden="true">
      {sidebar.map((g) => (
        <>
          <p class="fin-group">{g.group}</p>
          <ul>
            {g.items.map((i) => (
              <li class:list={[{ 'is-sel': i === 'EKHO_brain' }]}>
                <span class="fin-ico"></span>
                {i}
              </li>
            ))}
          </ul>
        </>
      ))}
    </nav>
    <div class="fin-cols" aria-hidden="true">
      <ul class="fin-col">
        {folders.map((f) => (
          <li class:list={['is-dir', { 'is-sel': f === '02 - Areas' }]}>
            <span class="fin-ico fin-ico--dir"></span>
            {f}
            <span class="fin-arrow">›</span>
          </li>
        ))}
        {files.map((f) => (
          <li>
            <span class="fin-ico fin-ico--doc"></span>
            {f}
          </li>
        ))}
      </ul>
      <ul class="fin-col">
        {inner.map((f) => (
          <li class:list={['is-dir', { 'is-sel': f === 'Decisions' }]}>
            <span class="fin-ico fin-ico--dir"></span>
            {f}
            <span class="fin-arrow">›</span>
          </li>
        ))}
      </ul>
      <ul class="fin-col fin-col--last">
        {notes.map((f) => (
          <li>
            <span class="fin-ico fin-ico--doc"></span>
            {f}
          </li>
        ))}
      </ul>
    </div>
  </div>
</figure>
