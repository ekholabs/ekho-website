---
// The models EKHO does not care about, as marks on identical plates.
//
// The paths come from the simple-icons package at build time, so they are the
// real outlines at their real proportions and not something drawn from memory.
// The package is CC0; the marks themselves stay the property of their owners,
// and this row is a statement of compatibility, not of endorsement.
//
// OpenAI is the exception: its mark is not in that set, because OpenAI asked
// for it to be removed. So GPT is set in type on the same plate rather than
// approximated. A drawn-from-memory logo would be both wrong and theirs.
import * as si from 'simple-icons';
import { type Lang } from '../i18n';

interface Props {
  /** the marks carry no copy; the prop keeps the call sites uniform */
  lang: Lang;
}
void Astro.props.lang;

type Plate = { label: string; icon?: { path: string; title: string }; text?: string };

const plates: Plate[] = [
  { label: 'Claude', icon: si.siClaude },
  { label: 'GPT', text: 'GPT' },
  { label: 'Gemini', icon: si.siGooglegemini },
  { label: 'Mistral', icon: si.siMistralai },
  { label: 'Llama, by Meta', icon: si.siMeta },
  { label: 'Qwen', icon: si.siQwen },
  { label: 'DeepSeek', icon: si.siDeepseek },
];
---

{/* Three times through on a phone, where the row is a strip you push. Three
    rather than two because the scroll has to be able to travel a whole set
    past the start before it wraps, and a screen's width of it is always
    visible. On a wide screen the row wraps onto two lines and the copies are
    not rendered. */}
<ul class="plates" data-plates>
  {[...plates, ...plates, ...plates].map((p, i) => (
    <li class:list={['plate-slot', { 'plate--dup': i >= plates.length }]}>
      {/* Pressing one puts its mark on the answer in the window below and says
          so at the foot of the screen. The mark travels as data on the button,
          so the page carries each outline exactly once. */}
      <button
        class="plate"
        type="button"
        title={p.label}
        data-pick={p.label}
        data-mark={p.icon?.path ?? ''}
        data-text={p.text ?? ''}
        aria-pressed={p.label === 'Claude'}
      >
        {p.icon ? (
          <svg class="plate-mark" viewBox="0 0 24 24" role="img" aria-label={p.label}>
            <path d={p.icon.path} />
          </svg>
        ) : (
          <span class="plate-text" aria-label={p.label}>
            {p.text}
          </span>
        )}
      </button>
    </li>
  ))}
</ul>

<script>
  // Picking a model. The mark on the answer in the mocked client follows the
  // plate that was pressed, and a line at the foot of the screen says which
  // one it is — the same way a client tells you which model a thread is on.
  const picked = document.querySelector<HTMLElement>('[data-picked]');
  const marks = document.querySelectorAll<HTMLElement>('[data-chat-mark]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-pick]');
  // The wire above the window says the two are joined; on a pick it shows the
  // joining happen. Both ends light in the signal colour and a yellow line
  // runs from the model to the vault between them.
  const wires = document.querySelectorAll<HTMLElement>('.wire');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');
  let clear = 0;
  let unlit = 0;

  const light = () => {
    if (still.matches) return;
    window.clearTimeout(unlit);
    for (const w of wires) {
      w.classList.remove('is-lit');
      // a reflow between the two, or the class never left and nothing restarts
      void w.offsetWidth;
      w.classList.add('is-lit');
    }
    // The line reaches the other end at about a third of the run, and that is
    // where the scene picks it up: waiting for the ends to cool first left a
    // second of nothing between the connection being made and it being used.
    window.setTimeout(() => {
      document.dispatchEvent(new CustomEvent('ekho:picked'));
    }, 520);
    unlit = window.setTimeout(() => {
      for (const w of wires) w.classList.remove('is-lit');
    }, 1500);
  };

  for (const b of buttons) {
    b.addEventListener('click', () => {
      const name = b.dataset.pick ?? '';
      const path = b.dataset.mark ?? '';
      const text = b.dataset.text ?? '';

      for (const m of marks) {
        m.innerHTML = path
          ? `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="${path}"></path></svg>`
          : `<span class="chat-mark-text">${text}</span>`;
      }
      for (const other of buttons) {
        other.setAttribute('aria-pressed', String(other.dataset.pick === name));
      }
      light();
      if (picked) {
        picked.textContent = (picked.dataset.tpl ?? '{name}').replace('{name}', name);
        picked.hidden = false;
        window.clearTimeout(clear);
        clear = window.setTimeout(() => (picked.hidden = true), 2600);
      }
    });
  }
</script>

<script>
  // Endless in both directions. The list is rendered twice, so one set along
  // is the same picture as the start; when the scroll passes that seam it is
  // moved back by exactly one set, which no eye can see because the pixels
  // either side of it are identical. The set is measured from where the copy
  // begins rather than from half the scroll width, which would be off by the
  // strip's own padding. It starts one set in, so the first swipe backwards
  // wraps as well.
  const strip = document.querySelector<HTMLElement>('[data-plates]');
  if (strip) {
    const kids = strip.children;
    const setOf = () => {
      const n = kids.length / 3;
      const a = kids[0] as HTMLElement;
      const b = kids[n] as HTMLElement;
      return b && a ? b.offsetLeft - a.offsetLeft : 0;
    };
    let set = 0;
    const strips = window.matchMedia('(max-width: 63.999rem)');
    const arm = () => {
      set = strips.matches ? setOf() : 0;
      if (set > 0 && strip.scrollLeft === 0) strip.scrollLeft = set;
    };
    strip.addEventListener(
      'scroll',
      () => {
        if (set <= 0) return;
        if (strip.scrollLeft >= set * 2) strip.scrollLeft -= set;
        else if (strip.scrollLeft <= 0) strip.scrollLeft += set;
      },
      { passive: true },
    );
    arm();
    strips.addEventListener('change', arm);
    window.addEventListener('resize', arm);
  }
</script>
