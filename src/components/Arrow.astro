---
// The two arrows the page uses, from the icon set (ADR-0030).
//
// out  · leaves the page (an external link)
// send · commits what is in the field (the composer button in the mockup)
import Icon from './Icon.astro';

interface Props {
  kind?: 'out' | 'send';
  class?: string;
}
const { kind = 'out', class: cls } = Astro.props;
---

<Icon name={kind === 'out' ? 'arrow-up-right' : 'arrow-up'} class={cls} />
