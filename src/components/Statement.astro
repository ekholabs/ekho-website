---
// A paragraph that leads with its own first sentence. Borrowed from the way
// gigs.com carries a long block on a phone: the opening sentence set in
// medium, the rest regular, so a reader who takes only the first line still
// takes the point. Nothing in the copy changes — the split happens here, at
// the first sentence end followed by a space, and a paragraph that has only
// one sentence simply stays whole, unmarked and in one weight.
interface Props {
  text: string;
  class?: string;
}
const { text, class: cls } = Astro.props;

const m = /^(.+?[.?!])\s+(.+)$/s.exec(text);
const lead = m ? m[1] : text;
const rest = m ? m[2] : '';
// A statement of one sentence is a claim rather than an explanation — the
// model is the same for everyone, nothing is locked in, it never changes
// anything without showing you first. On a phone those are set larger, which
// gives a column of paragraphs something to rise to.
// Short enough to be a claim and not a description: at 150 characters two of
// them in a row read as a second heading.
const pull = !m && text.length < 80;
---

<p class:list={['ekho-statement', { 'ekho-statement--pull': pull }, cls]}>
  {/* No rest means the paragraph is one sentence, so there is no lead to mark:
      the span would put the whole block in medium, which is how a paragraph
      turns into a heading. It is only wrapped when there is something for the
      weight to separate it from. */}
  {rest ? <span class="ekho-statement__lead">{lead}</span> : lead}
  {rest && ' '}
  {rest}
</p>
