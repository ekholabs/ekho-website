---
// The EKHO architecture, after slide 23 of the pitch deck (Planet A,
// 2026-09-12), set for the dark site: the core layers in paper, the model
// in grey, what the member owns in signal yellow, the conversation and the
// return channel dotted. With data-arch the layers can build up top to
// bottom (the page toggles is-shown); without it the graphic is finished.

interface Props {
  animated?: boolean;
}
const { animated = true } = Astro.props;

const W = 640;
const X = 20;
const IW = W - 2 * X;
const layers = [
  {
    kind: 'conversation',
    title: 'Conversation',
    code: 'ekho-stream',
    note: 'Interface to every layer',
    y: 20,
  },
  { kind: 'core', title: 'Ontology', code: 'ekho-core', note: 'Types, links, rules', y: 104 },
  {
    kind: 'core',
    title: 'Harness',
    code: 'ekho-cockpit',
    note: 'Workflows that apply the grammar',
    y: 188,
  },
  { kind: 'llm', title: 'LLM', code: '', note: 'Swappable reasoning engine', y: 288 },
];
const H = 70;
const boxW = (IW - 2 * 24) / 3;
const owned = [
  { title: 'Knowledge', code: 'ekho-knowledge-vault' },
  { title: 'Specs', code: 'ekho-spec-vault' },
  { title: 'Code', code: 'ekho-applications' },
];
const oy = 388;
const oh = 96;
const legend = [
  { kind: 'core', label: 'EKHO core', x: 0 },
  { kind: 'llm', label: 'Swappable LLM', x: 118 },
  { kind: 'owned', label: 'Owned by the member', x: 262 },
  { kind: 'return', label: 'Return channel', x: 450 },
];
---

<figure
  class="arch-graphic"
  data-arch={animated ? '' : undefined}
  role="img"
  aria-label="The EKHO architecture. A conversation is the interface to every layer. Below it the EKHO core: the ontology (types, links, rules) and the harness (workflows that apply the grammar). Then a swappable LLM as the reasoning engine. At the bottom what the member owns: knowledge, specs and code, each feeding the next, with code returning to knowledge."
>
  <svg viewBox="0 0 640 600" aria-hidden="true">
    {layers.map((l, i) => (
      <g class="ar-layer" style={`--d: ${i}`}>
        <rect class={`ar-box ar-${l.kind}`} x={X} y={l.y} width={IW} height={H} rx="14" />
        <text class={`ar-title ar-t-${l.kind}`} x={X + 22} y={l.y + 43}>
          {l.title}
          {l.code && <tspan class={`ar-code ar-c-${l.kind}`}> | {l.code}</tspan>}
        </text>
        <text class={`ar-note ar-t-${l.kind}`} x={X + IW - 22} y={l.y + 42} text-anchor="end">
          {l.note}
        </text>
      </g>
    ))}

    {owned.map((o, i) => {
      const x = X + i * (boxW + 24);
      return (
        <g class="ar-layer" style={`--d: ${4 + i}`}>
          <rect class="ar-box ar-owned" x={x} y={oy} width={boxW} height={oh} rx="14" />
          <text class="ar-title ar-t-owned" x={x + 16} y={oy + 38}>
            {o.title}
          </text>
          <text class="ar-code ar-c-owned" x={x + 16} y={oy + 70}>
            {o.code}
          </text>
          {i < 2 && (
            <path
              class="ar-arrow"
              d={`M ${x + boxW + 3} ${oy + 44} L ${x + boxW + 19} ${oy + 44} M ${x + boxW + 14} ${oy + 39} L ${x + boxW + 20} ${oy + 44} L ${x + boxW + 14} ${oy + 49}`}
            />
          )}
        </g>
      );
    })}

    <!-- return channel: from code back to knowledge -->
    <g class="ar-layer" style="--d: 7">
      <path
        class="ar-return"
        d={`M ${X + 2 * (boxW + 24) + boxW / 2} ${oy + oh + 4} L ${X + 2 * (boxW + 24) + boxW / 2} ${oy + oh + 22} L ${X + boxW / 2} ${oy + oh + 22} L ${X + boxW / 2} ${oy + oh + 8}`}
      ></path>
      <path
        class="ar-arrow"
        d={`M ${X + boxW / 2 - 5} ${oy + oh + 12} L ${X + boxW / 2} ${oy + oh + 5} L ${X + boxW / 2 + 5} ${oy + oh + 12}`}
      ></path>
    </g>

    <!-- legend -->
    <g class="ar-layer ar-legend" style="--d: 8">
      {legend.map((k) => (
        <g transform={`translate(${X + k.x} 560)`}>
          <rect class={`ar-swatch ar-s-${k.kind}`} x="0" y="-13" width="16" height="16" rx="4" />
          <text class="ar-legend-text" x="24" y="0">
            {k.label}
          </text>
        </g>
      ))}
    </g>
  </svg>
</figure>
