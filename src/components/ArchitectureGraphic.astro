---
// Who owns what, as stacked layers. Colour carries the meaning, as in the
// pitch deck: black is EKHO, yellow is yours, grey is replaceable; hatching
// means it does not exist yet. With data-arch the layers can build up from
// the bottom (the page toggles is-shown); without it the graphic is finished.

interface Props {
  animated?: boolean;
  idPrefix?: string;
}
const { animated = true, idPrefix = 'ar' } = Astro.props;
const tileId = `${idPrefix}-tile`;
const hatchId = `${idPrefix}-hatch`;

const person = '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/>';
const terminal =
  '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 9 3 3-3 3M12 15h5"/>';
---

<figure
  class="arch-graphic"
  data-arch={animated ? '' : undefined}
  role="img"
  aria-label="Three layers. At the bottom EKHO Core: shared vocabulary, typed links, an open format and a harness that keeps your agent in line. Above it your profile, your own terms on top of the core, in development. On top your knowledge, the files that are yours. You and your replaceable AI agent both read the same files."
>
  <svg viewBox="0 0 640 620" aria-hidden="true">
    <defs>
      <linearGradient id={tileId} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color: var(--tile-top)"></stop>
        <stop offset="1" style="stop-color: var(--tile-bottom)"></stop>
      </linearGradient>
      <pattern
        id={hatchId}
        width="12"
        height="12"
        patternUnits="userSpaceOnUse"
        patternTransform="rotate(45)"
      >
        <rect width="12" height="12" style="fill: var(--surface)"></rect>
        <rect width="6" height="12" style="fill: var(--stripe)"></rect>
      </pattern>
    </defs>

    <!-- the two readers: grey, replaceable -->
    <g class="ar-layer" style="--d: 3">
      <path class="ar-line" d="M 186 118 C 186 160, 200 170, 200 200"></path>
      <path class="ar-line" d="M 454 118 C 454 160, 440 170, 440 200"></path>
      <text class="ar-mid" x="320" y="164" text-anchor="middle">
        same files
      </text>
      <g transform="translate(150 40)">
        <rect class="ar-tile" width="72" height="72" rx="16" fill={`url(#${tileId})`}></rect>
        <svg class="ar-icon" x="24" y="24" width="24" height="24" viewBox="0 0 24 24">
          <g set:html={person} />
        </svg>
        <text class="ar-label" x="36" y="-12" text-anchor="middle">
          You
        </text>
      </g>
      <g transform="translate(418 40)">
        <rect class="ar-tile" width="72" height="72" rx="16" fill={`url(#${tileId})`}></rect>
        <svg class="ar-icon" x="24" y="24" width="24" height="24" viewBox="0 0 24 24">
          <g set:html={terminal} />
        </svg>
        <text class="ar-label" x="36" y="-12" text-anchor="middle">
          Your AI agent
        </text>
      </g>
      <text class="ar-note" x="508" y="82">
        replaceable
      </text>
    </g>

    <!-- your knowledge: yellow, yours -->
    <g class="ar-layer" style="--d: 2">
      <rect class="ar-knowledge" x="60" y="200" width="520" height="110" rx="22"></rect>
      <text class="ar-title ar-on-signal" x="88" y="246">
        Your knowledge
      </text>
      <text class="ar-sub ar-on-signal" x="88" y="276">
        Markdown files in your folder, typed and linked
      </text>
    </g>

    <!-- your profile: hatched, does not exist yet -->
    <g class="ar-layer" style="--d: 1">
      <rect x="60" y="326" width="520" height="96" rx="22" fill={`url(#${hatchId})`}></rect>
      <rect class="ar-profile" x="60" y="326" width="520" height="96" rx="22"></rect>
      <text class="ar-title" x="88" y="366">
        Your profile
      </text>
      <text class="ar-sub" x="88" y="396">
        Your terms and types on top of the core
      </text>
      <rect class="ar-tag" x="438" y="346" width="122" height="30" rx="15"></rect>
      <text class="ar-tag-text" x="499" y="366" text-anchor="middle">
        in development
      </text>
    </g>

    <!-- EKHO core: black -->
    <g class="ar-layer" style="--d: 0">
      <rect class="ar-core" x="60" y="438" width="520" height="150" rx="22"></rect>
      <text class="ar-title" x="88" y="482">
        EKHO Core
      </text>
      <text class="ar-sub" x="88" y="512">
        Shared vocabulary · typed links · open format
      </text>
      <text class="ar-sub" x="88" y="540">
        Harness: rules for your agent, and a linter
      </text>
      <text class="ar-sub" x="88" y="564">
        that enforces them
      </text>
    </g>
  </svg>
  <figcaption class="ar-caption">
    Black is EKHO. <span class="signal-text">Yellow is yours.</span> Grey is replaceable.
  </figcaption>
</figure>
