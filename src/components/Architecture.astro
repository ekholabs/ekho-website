---
// Chapter 06. The same five layers the rail assembles while you scroll, at full
// size and openable. One model on the page, not two: what builds up above is
// what you can read in detail here.
//
// Built on <details name="arch">, so it works without JavaScript and by
// keyboard, and only one layer is open at a time.

const layers = [
  {
    key: 'conversation',
    title: 'Conversation',
    note: 'between people',
    lead: 'Where knowledge starts:',
    text: 'the conversations you have with the people you work with. A call, a meeting, a decision made out loud. Almost none of it is written down, and that is the part EKHO is after.',
  },
  {
    key: 'llm',
    title: 'LLM',
    note: 'interchangeable',
    lead: 'The means, not the place:',
    text: 'the engine that reads, writes and links. EKHO works with any model, frontier, open or locally hosted, so you can swap the model and your knowledge stays exactly where it was.',
  },
  {
    key: 'harness',
    title: 'Harness',
    code: 'ekho-cockpit',
    note: 'CLI and skills',
    lead: 'The layer that puts the grammar to work:',
    text: 'skills, workflows and a linter that take in sources, answer questions and keep everything consistent. It turns something one person prompted once into behaviour anyone can repeat.',
  },
  {
    key: 'ontology',
    title: 'Ontology',
    code: 'ekho-core',
    note: 'types, edges, rules',
    lead: 'Knowledge is a contract about what is true:',
    text: 'a shared understanding, a shared language, a shared intent. Between people that contract is spoken and renegotiated. The ontology is the same contract written down for machines: what a note is, how notes relate, and what a word means when your field uses it. It is declared rather than prompted, so every vault behaves the same and each field can extend it without breaking the core.',
  },
  {
    key: 'vault',
    title: 'EKHO Vault',
    note: 'Knowledge · Specs · Code',
    lead: 'What you own:',
    text: 'plain Markdown on your own disk. It becomes more valuable with every session, and nothing in the layers above it is allowed to hold it hostage.',
    parts: [
      {
        title: 'Knowledge',
        code: 'ekho-knowledge-vault',
        text: 'Sources, insights, hypotheses and decisions. Where the thinking lives.',
      },
      {
        title: 'Specs',
        code: 'ekho-spec-vault',
        text: 'The bridge from validated knowledge to buildable requirements. Anything built can be traced back to why.',
      },
      {
        title: 'Code',
        code: 'ekho-applications',
        text: 'The running software, built from specs and fed back in as evidence. Every shipped feature closes the loop.',
      },
    ],
  },
];
---

<div class="arch" data-arch>
  {layers.map((l) => (
    <details class:list={['arch-row', `arch-row--${l.key}`]} name="arch">
      <summary class="arch-head">
        <span class="arch-title">
          {l.key === 'vault' && <span class="arch-sq" aria-hidden="true"></span>}
          {l.title}
          {l.code && <span class="arch-code">{l.code}</span>}
        </span>
        <span class="arch-note">{l.note}</span>
      </summary>
      <div class="arch-desc">
        <p>
          <strong>{l.lead}</strong> {l.text}
        </p>
        {l.parts && (
          <ul class="arch-parts">
            {l.parts.map((p) => (
              <li>
                <b>{p.title}</b>
                <code>{p.code}</code>
                <span>{p.text}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </details>
  ))}
</div>
