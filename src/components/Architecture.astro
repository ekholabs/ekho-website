---
// Chapter 06. The same five layers the rail assembles while you scroll, at full
// size and openable. One model on the page, not two: what builds up above is
// what you can read in detail here.
//
// Built on <details name="arch">, so it works without JavaScript and by
// keyboard, and only one layer is open at a time.

import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = t(lang).architecture.layers;

const layers = [
  { key: 'conversation', ...L.conversation },
  { key: 'llm', ...L.llm },
  { key: 'harness', code: 'ekho-cockpit', ...L.harness },
  { key: 'ontology', code: 'ekho-core', ...L.ontology },
  // The vault used to break into knowledge, specs and code here. The split is
  // out for now — it describes how the vault is worked with rather than what
  // the layer is — and the .arch-parts styles are still in place for when it
  // comes back.
  { key: 'vault', ...L.vault },
] as {
  key: string;
  title: string;
  note: string;
  lead: string;
  text: string;
  code?: string;
}[];
---

<div class="arch" data-arch>
  {layers.map((l) => (
    <details class:list={['arch-row', `arch-row--${l.key}`]} name="arch">
      <summary class="arch-head">
        <span class="arch-title">
          {l.key === 'vault' && <span class="ekho-dot arch-sq" aria-hidden="true"></span>}
          {l.title}
          {l.code && <span class="arch-code">{l.code}</span>}
        </span>
        <span class="arch-note">{l.note}</span>
      </summary>
      <div class="arch-desc">
        <p>
          <strong>{l.lead}</strong> {l.text}
        </p>
      </div>
    </details>
  ))}
</div>
