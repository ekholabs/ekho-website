---
// The design system, as a page (ADR-0028). For now it shows the proposal for
// step 2: the scales read off the site, before the site is switched over to
// them. Not linked from anywhere and, like every page until launch, noindex.
import Base from '../layouts/Base.astro';
import '../styles/ds/tokens.css';
import '../styles/ds/showcase.css';

const type = [
  {
    token: 'display',
    sample: 'AI is as good as your context.',
    size: '40 → 52',
    meta: '600 · 1.06 · −0.035em',
    was: 'the hero title (39.75 → 52)',
  },
  {
    token: 'h2',
    sample: 'A wallet for your most valuable asset.',
    size: '32 → 38',
    meta: '600 · 1.06 · −0.025em',
    was: 'chapter headings (33.4 → 38) and the two later ones (24 → 34)',
  },
  {
    token: 'h3',
    sample: 'The EKHO architecture',
    size: '20 → 24',
    meta: '600 · 1.25 · −0.015em',
    was: 'architecture rows (17 → 24.5), plate text, bold leads (20, 22)',
  },
  {
    token: 'title',
    sample: 'Show the change before making it',
    size: '17',
    meta: '600 · 1.25 · −0.015em',
    was: 'card titles, names, architecture rows on a phone',
  },
  {
    token: 'body',
    sample:
      'Context is what connects the most disparate things you know, at the moment you ask. Your decisions and why you made them, the people you work with.',
    size: '16 → 18',
    meta: '400 · 1.6 · 0',
    was: 'hero lede, statements, chapter ledes (18 everywhere), chat on a phone (16)',
  },
  {
    token: 'small',
    sample: 'Join the waitlist · See how it works',
    size: '14',
    meta: '400 or 500 · 1.45',
    was: 'buttons, navigation, captions, and the 15 px of the phone chat',
  },
  {
    token: 'caption',
    sample:
      'The viewer is in build. The roadmap is not: it is generated today, from the same files.',
    size: '13',
    meta: '400 · 1.45',
    was: 'notes, figure notes, chat lines, row notes',
  },
  {
    token: 'label',
    sample: '01 Why',
    size: '12',
    meta: '500 · uppercase · +0.1em',
    was: 'twelve eyebrow styles (10 to 13 px, 400 to 600, five trackings)',
  },
  {
    token: 'micro',
    sample: '260925_anna.m4a · 3:12',
    size: '11',
    meta: '400 · 1.45 · mock-ups only',
    was: 'mock-up labels at 11, 10 and 9 px',
  },
];

const space = [
  ['0-5', 2, '0.15, 0.2 rem'],
  ['1', 4, '0.25 to 0.35 rem'],
  ['2', 8, '0.4 to 0.6 rem, the most used group'],
  ['3', 12, '0.65 to 0.75 rem'],
  ['4', 16, '0.9 to 1.15 rem'],
  ['5', 20, '1.25 rem'],
  ['6', 24, '1.5, 1.6 rem'],
  ['8', 32, '2 rem'],
  ['10', 40, '2.5 rem'],
  ['12', 48, '3 rem'],
  ['16', 64, '4 rem'],
  ['24', 96, 'the larger section offsets'],
] as const;

const radii = [
  ['sm', 'var(--radius-sm)', '4 px · the default', '1, 3 and 4 px: buttons, fields, rows, panels'],
  ['md', 'var(--radius-md)', '8 px', '7, 8, 9 px: tools, chat buttons, clips'],
  ['lg', 'var(--radius-lg)', '12 px', '10, 14, 20, 24 px: windows, bubbles, strip cards'],
  ['full', 'var(--radius-full)', 'round', '50 % and 999 px: dots, keys, the phone composer'],
] as const;

const oldRadii = ['1px', '3px', '4px', '7px', '8px', '9px', '10px', '14px', '20px', '24px'];

const shadows = [
  [
    'sm',
    'var(--shadow-sm)',
    'a small card on a surface',
    '0 2px 10px, 0 1px 8px, the graphic’s card',
  ],
  [
    'md',
    'var(--shadow-md)',
    'a window, a raised card',
    'five offset shadows, three of them identical',
  ],
  ['lift', 'var(--shadow-lift)', 'a panel off the page', '--lift (unchanged)'],
  [
    'lift-hover',
    'var(--shadow-lift-hover)',
    'the same, under the pointer',
    '--lift-hover (unchanged)',
  ],
] as const;

const motion = [
  [
    'fast',
    'var(--duration-fast)',
    'var(--ease-standard)',
    '180 ms',
    'hover, focus, press',
    '180, 200, 240 ms, 0.2 s, 0.25 s',
  ],
  [
    'base',
    'var(--duration-base)',
    'var(--ease-out)',
    '320 ms',
    'a state changes',
    '320, 400, 420 ms',
  ],
  [
    'slow',
    'var(--duration-slow)',
    'var(--ease-settle)',
    '760 ms',
    'something enters',
    '500, 760 ms',
  ],
] as const;

const colours = [
  ['bg', 'page'],
  ['surface', 'panels, cards'],
  ['surface-raised', 'a step above'],
  ['line', 'hairlines'],
  ['line-strong', 'outlines'],
  ['muted-deep', 'quiet text'],
  ['muted', 'secondary text'],
  ['text', 'ink'],
  ['signal', 'what is yours'],
  ['core', 'EKHO core, screens'],
] as const;
---

<Base
  title="Design system — EKHO Labs"
  description="The tokens and parts EKHO's surfaces are built from."
  layout="wide"
>
  <div class="wrap wrap-wide ds">
    <header class="ds-head">
      <p class="ds-eyebrow">
        <b>EKHO</b> · Design system · step 2
      </p>
      <h1 class="ds-title">The scales, read off the site.</h1>
      <p class="ds-lead">
        <strong>ekholabs.eu is the reference</strong> (ADR-0028). Every scale below comes from what
        the page renders today at 375 and 1440 px: the values that carry it become the steps, the
        strays snap to the nearest one. Resize the window to see the fluid steps move.
      </p>
      <span class="ds-status">
        <span class="ds-dot"></span>Proposal · not applied to the site yet
      </span>
    </header>

    <section class="ds-section">
      <h2>Colour</h2>
      <p>
        Unchanged from v0.5 (ADR-0027). Light is the main mode; switch your system to dark to see
        the second.
      </p>
      <div class="ds-modes">
        {(['light', 'dark'] as const).map((m) => (
          <div class:list={['ds-mode', `ds-mode--${m}`]}>
            <p class="ds-eyebrow">{m === 'light' ? 'Light · main mode' : 'Dark · second mode'}</p>
            <div class="ds-swatches">
              {colours.map(([t, use]) => (
                <div class="ds-swatch">
                  <i style={`background: var(--${t})`} />
                  <span class="ds-name">--{t}</span>
                  <span>{use}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
      <div class="ds-open">
        <h3>Goes in the switch-over</h3>
        <ul>
          <li>
            --stripe, --surface-hover, --dots, --core-ink, --core-line, --core-muted: defined, never
            used
          </li>
          <li>--border is --line under another name</li>
        </ul>
      </div>
    </section>

    <section class="ds-section">
      <h2>Type</h2>
      <p>
        Nine sizes instead of 36. Three weights: 400 for text, 500 for labels and lead-ins, 600 for
        every heading. Mono only for what a machine reads: commands, file names, ids.
      </p>
      <div class="ds-rows">
        {type.map((r) => (
          <div class="ds-row">
            <span class="ds-name">--text-{r.token}</span>
            <p class:list={['ds-spec', `ds-spec--${r.token}`]} data-spec>
              {r.sample}
            </p>
            <span class="ds-meta">
              <b>{r.size} px</b> · now{' '}
              <span class="ds-now" data-now>
                …
              </span>
              <br />
              {r.meta}
            </span>
            <span class="ds-was">{r.was}</span>
          </div>
        ))}
        <div class="ds-row">
          <span class="ds-name">--font-mono</span>
          <p class="ds-spec ds-spec--mono">$ ekho tools transcribe 260925_anna.m4a</p>
          <span class="ds-meta">
            <b>12 px</b>
            <br />
            system mono
          </span>
          <span class="ds-was">mono at 10 to 15 px</span>
        </div>
      </div>
    </section>

    <section class="ds-section">
      <h2>Space</h2>
      <p>
        A 4 px grid, twelve steps instead of 63 values. One side margin, <code>--gutter</code>, 16
        px: today full-bleed rows fall back to 20 px and sit 4 px off the text column.
      </p>
      <div class="ds-rows">
        {space.map(([n, px, was]) => (
          <div class="ds-row">
            <span class="ds-name">--space-{n}</span>
            <div class="ds-bar" style={`width: var(--space-${n})`} />
            <span class="ds-meta">
              <b>{px} px</b>
            </span>
            <span class="ds-was">{was}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="ds-section">
      <h2>Radius</h2>
      <p>
        Three steps of four, plus round. 4 px stays the default; 8 and 12 are for what sits inside a
        window and for the window itself.
      </p>
      <div class="ds-tiles">
        {radii.map(([n, v, label, was]) => (
          <div class="ds-tile" style={`border-radius: ${v}`}>
            <span class="ds-name">--radius-{n}</span>
            <span class="ds-meta">
              <b>{label}</b>
            </span>
            <span class="ds-was">{was}</span>
          </div>
        ))}
      </div>
      <p class="ds-eyebrow">Today, ten values</p>
      <div class="ds-old">
        {oldRadii.map((r) => (
          <span style={`border-radius: ${r}`}>{r}</span>
        ))}
      </div>
    </section>

    <section class="ds-section">
      <h2>Elevation</h2>
      <p>
        Four shadows, each with a dark version. Today eight shadows are drawn in light ink and all
        but vanish on the dark ground.
      </p>
      <div class="ds-modes">
        {(['light', 'dark'] as const).map((m) => (
          <div class:list={['ds-mode', `ds-mode--${m}`]}>
            <p class="ds-eyebrow">{m === 'light' ? 'Light' : 'Dark'}</p>
            <div class="ds-tiles ds-tiles--shadow">
              {shadows.map(([n, v, use]) => (
                <div class="ds-tile" style={`box-shadow: ${v}`}>
                  <span class="ds-name">--shadow-{n}</span>
                  <span class="ds-meta">
                    <b>{use}</b>
                  </span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="ds-section">
      <h2>Motion</h2>
      <p>
        Three durations and three curves instead of 41 durations and six curves. The long
        choreography in the context graphic and the chat scene stays where it is: it is a scene, not
        a part.
      </p>
      <div class="ds-rows">
        {motion.map(([n, d, e, ms, use, was]) => (
          <div class="ds-row ds-motion" data-motion>
            <span class="ds-name">--duration-{n}</span>
            <div class="ds-track">
              <span class="ds-dot" style={`transition: left ${d} ${e}`} />
            </div>
            <span class="ds-meta">
              <b>{ms}</b> · {use}
              <br />
              {e.replace('var(--', '').replace(')', '')}
            </span>
            <span class="ds-was">{was}</span>
          </div>
        ))}
      </div>
      <p style="margin-top: var(--space-6)">
        <button class="ds-play" type="button" data-play>
          Play
        </button>
      </p>
    </section>

    <section class="ds-section">
      <h2>Small parts</h2>
      <p>Things that repeat often enough to be one value instead of several copies.</p>
      <div class="ds-parts">
        <div class="ds-part">
          <span class="ds-name">--focus-ring</span>
          <button class="ds-play ds-focus" type="button">
            Tab to me
          </button>
          <span class="ds-was">nine copies of the same outline</span>
        </div>
        <div class="ds-part">
          <span class="ds-name">--dot-size</span>
          <span class="ds-dot"></span>
          <span class="ds-was">eight signal squares at 8, 9 and 11 px</span>
        </div>
        <div class="ds-part">
          <span class="ds-name">--underline-thin</span>
          <span class="ds-spec--body">
            <span class="ds-u-thin">a link in running text</span>
          </span>
          <span class="ds-was">links, and the 1.5 px under names</span>
        </div>
        <div class="ds-part">
          <span class="ds-name">--underline-bold</span>
          <span class="ds-spec--h3">
            <span class="ds-u-bold">Own it.</span>
          </span>
          <span class="ds-was">the signal under the hero title</span>
        </div>
        <div class="ds-part">
          <span class="ds-name">--bp-md · --bp-lg</span>
          <span class="ds-spec--small">
            Phone below 48 rem, desktop from 64 rem. Between the two the page keeps the phone
            layout.
          </span>
          <span class="ds-was">35 literal media queries and seven copies in scripts</span>
        </div>
        <div class="ds-part">
          <span class="ds-name">--z-header · --z-toast</span>
          <span class="ds-spec--small">20 and 40 across the page; inside a component, 0 to 9.</span>
          <span class="ds-was">thirteen z-index values</span>
        </div>
      </div>
    </section>

    <section class="ds-section">
      <h2>What changes when the site switches over</h2>
      <p>Snapping to the steps moves a few things you can see. These are the ones worth a look.</p>
      <div class="ds-rows">
        <div class="ds-row">
          <span class="ds-name">type</span>
          <span class="ds-spec--small">
            Architecture rows on a phone grow from 17 to 20 px; the two later headings from 24 to 32
            px on a phone; the phone chat goes from 15 and 16 to 14 and 16.
          </span>
          <span></span>
          <span></span>
        </div>
        <div class="ds-row">
          <span class="ds-name">label</span>
          <span class="ds-spec--small">
            Chapter labels go from 400 to 500 and lose their 13 px on a phone.
          </span>
          <span></span>
          <span></span>
        </div>
        <div class="ds-row">
          <span class="ds-name">radius</span>
          <span class="ds-spec--small">
            Strip cards go from 20 to 12 px, windows from 10 to 12, chat bubbles from 14 to 12.
          </span>
          <span></span>
          <span></span>
        </div>
        <div class="ds-row">
          <span class="ds-name">gutter</span>
          <span class="ds-spec--small">
            Full-bleed rows move 4 px and line up with the text column.
          </span>
          <span></span>
          <span></span>
        </div>
        <div class="ds-row">
          <span class="ds-name">dark</span>
          <span class="ds-spec--small">Shadows become visible on the dark ground.</span>
          <span></span>
          <span></span>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  // the size each fluid step resolves to at the width the page is read at
  const update = () => {
    for (const spec of document.querySelectorAll<HTMLElement>('[data-spec]')) {
      const out = spec.parentElement?.querySelector<HTMLElement>('[data-now]');
      if (out)
        out.textContent = `${Math.round(parseFloat(getComputedStyle(spec).fontSize) * 10) / 10} px`;
    }
  };
  update();
  addEventListener('resize', update);

  const play = document.querySelector<HTMLButtonElement>('[data-play]');
  play?.addEventListener('click', () => {
    for (const row of document.querySelectorAll('[data-motion]')) row.classList.toggle('is-on');
  });
</script>
