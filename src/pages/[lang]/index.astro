---
// One built page per language, not a switch that swaps text in the browser:
// this site is static, and a language that only exists after JavaScript has run
// is invisible to a crawler, a reader mode or anyone sharing the link.
import Home from '../../components/Home.astro';
import { langs, defaultLang, type Lang } from '../../i18n';

export function getStaticPaths() {
  return langs.filter((l) => l !== defaultLang).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
---

<Home lang={lang} />
