---
import Base from '../layouts/Base.astro';
import ContextGraphic from '../components/ContextGraphic.astro';
import Architecture from '../components/Architecture.astro';
import ArchStack from '../components/ArchStack.astro';
import FinderWindow from '../components/FinderWindow.astro';
import ChatWindow from '../components/ChatWindow.astro';
import ViewerMockup from '../components/ViewerMockup.astro';
import Waitlist from '../components/Waitlist.astro';

// The scroll is the lifecycle of a vault: scattered before EKHO, connected with
// it, compounding once it runs. The graphic on the right holds that movement,
// the column on the left carries the statement, the environment the reader
// already works in, and the architecture assembling layer by layer.
// Full spec: docs/landing-v2.md
const chapters = [
  { id: 'why', n: '01', label: 'Why' },
  { id: 'what', n: '02', label: 'What' },
  { id: 'how', n: '03', label: 'How' },
  { id: 'architecture', n: '04', label: 'Architecture' },
];

// The two founders. Names on a public page are the one thing never to guess.
const people = [
  { name: 'Lorenz Vierecke', line: 'Puts EKHO in front of real work and writes down what breaks.' },
  {
    name: 'Stephan Georg',
    line: 'Builds the harness underneath: the CLI, the grammar, the workflows.',
  },
];
---

<Base
  title="EKHO Labs — AI is only as good as your context"
  description="EKHO turns what you know into connected context that compounds, so you get more out of AI every time you use it, and it stays yours."
  layout="wide"
>
  <nav
    class="chapter-nav"
    id="chapter-nav"
    aria-label="Chapters"
    slot="header-nav"
    data-chapter-nav
  >
    <ol>
      {chapters.map((c) => (
        <li>
          <a href={`#${c.id}`} data-chapter-link={c.id}>
            <span class="chapter-nav-n">{c.n}</span>
            {c.label}
          </a>
        </li>
      ))}
      <li class="chapter-nav-extra">
        <a href="#waitlist">
          <span class="chapter-nav-n">05</span>
          Join the waitlist
        </a>
      </li>
      <li class="chapter-nav-extra">
        <a href="https://github.com/ekholabs">
          <span class="chapter-nav-n">↗</span>
          GitHub
        </a>
      </li>
    </ol>
  </nav>

  {/* ---------- the story: graphic right, everything else left ---------- */}
  <div class="wrap wrap-wide story">
    <div class="story-figure" data-story-figure>
      <div class="figure-stage">
        <ContextGraphic caption={false} />
        <div class="overlay" data-for="finder">
          <FinderWindow />
        </div>
        <div class="overlay" data-for="chat">
          <ChatWindow />
        </div>
      </div>
      <ArchStack rail label={false} />
    </div>

    <div class="story-text">
      <section class="chapter chapter--hero" id="hero" data-chapter data-stage="0">
        <div class="chapter-body">
          <h1 class="hero-title">
            AI is only as good as your context. <span class="signal-text">Own it.</span>
          </h1>
          <p class="hero-lede">
            EKHO turns what you know into one connected context your AI can work with. Every time
            you use it, you get more out of it. And it stays yours.
          </p>
          <p class="cta-row">
            <a class="pill pill--solid" href="#waitlist">
              Join the waitlist
            </a>
            <a class="pill" href="#why">
              See how it works <span aria-hidden="true">↓</span>
            </a>
          </p>
        </div>
      </section>

      <section
        class="chapter"
        id="why"
        data-chapter
        data-nav="why"
        data-stage="1"
        data-layers=""
        data-done=""
      >
        <div class="chapter-body measure">
          <p class="chapter-label">
            <span>01</span> Why
          </p>
          <h2>Everything is already there. None of it is connected.</h2>
          <div data-seq>
            <p class="statement" data-step>
              Your decisions, the people you work with, what you have read and what you concluded
              from it. It exists. In your head, in chats that close, in mails and meetings and notes
              that know nothing of each other.
            </p>
            <p class="statement" data-step>
              So every session with an AI starts near zero. You explain yourself again. And again.
            </p>
            <p class="statement" data-step>
              The model is the same for everyone. Your context is the only part that is yours.
            </p>
          </div>
        </div>
      </section>

      <section
        class="chapter"
        id="what"
        data-chapter
        data-nav="what"
        data-stage="2"
        data-layers="vault"
        data-done=""
        data-overlay="finder"
      >
        <div class="chapter-body measure">
          <p class="chapter-label">
            <span>02</span> What
          </p>
          <h2>One place your knowledge actually lives.</h2>
          <p class="statement">
            EKHO is a folder on your machine. Markdown files, one form, one grammar. Readable by you
            and by any agent you let near it.
          </p>
          <p class="statement">
            Nothing is locked in. You can open it, read it, move it, delete it. It is not a memory
            inside somebody else's model.
          </p>
        </div>
        <div class="flow-window">
          <FinderWindow />
        </div>
      </section>

      <section
        class="chapter"
        id="how"
        data-chapter
        data-nav="how"
        data-stage="2"
        data-layers="conversation llm harness"
        data-done="vault"
        data-overlay="chat"
      >
        <div class="chapter-body measure">
          <p class="chapter-label">
            <span>03</span> How
          </p>
          <h2>The conversation is the interface.</h2>
          <p class="statement">
            No new app. EKHO docks into the chat you already use: as commands it runs and skills it
            applies.
          </p>
          <p class="statement">And it never changes anything without showing you first.</p>
        </div>
        <div class="flow-window">
          <ChatWindow />
        </div>
        <ol class="steps-strip">
          <li>
            <span>01</span> Throw it in.
          </li>
          <li>
            <span>02</span> Let it be digested.
          </li>
          <li>
            <span>03</span> Ask.
          </li>
        </ol>
      </section>

      <section
        class="chapter"
        id="compound"
        data-chapter
        data-nav="how"
        data-stage="3"
        data-layers="ontology"
        data-done="conversation llm harness vault"
      >
        <div class="chapter-body measure">
          <p class="chapter-label">
            <span>03</span> How
          </p>
          <h2>Not one new point. Three times the connections.</h2>
          <div data-seq>
            <p class="statement" data-step>
              Every source you bring in links to everything already there. An insight knows where it
              came from, what supports it and what contradicts it.
            </p>
            <p class="statement" data-step>
              That is why it compounds instead of gathering dust. The bookkeeping is the part people
              give up on, and it is the part the agent does.
            </p>
          </div>
        </div>
      </section>
    </div>
  </div>

  {/* ---------- 05 · what EKHO is ---------- */}
  <section
    class="wrap wrap-wide chapter chapter--wide"
    id="viewer"
    data-chapter
    data-nav="how"
    data-stage="3"
  >
    <div class="measure">
      <h2>This is what it looks like.</h2>
      <p class="chapter-lede">Your vault, readable. On your desk and in your pocket.</p>
    </div>
    <ViewerMockup />
    <p class="fig-note measure">
      710 notes, read only, your files stay files. The viewer is in build. The vault underneath it
      is not: it is the one this site was written in.
    </p>
  </section>

  {/* ---------- 06 · architecture ---------- */}
  <section
    class="wrap wrap-wide chapter chapter--wide"
    id="architecture"
    data-chapter
    data-nav="architecture"
    data-stage="3"
  >
    <div class="measure">
      <p class="chapter-label">
        <span>04</span> Architecture
      </p>
      <h2>The EKHO architecture</h2>
      <p class="chapter-lede">
        Any AI can keep notes. EKHO adds the grammar and the workflows that make them repeatable,
        and compatible with every other EKHO vault.
      </p>
    </div>
    <Architecture />
  </section>

  {/* ---------- 07 · who ---------- */}
  <section
    class="wrap wrap-wide chapter chapter--wide"
    id="who"
    data-chapter
    data-nav="architecture"
    data-stage="3"
  >
    <div class="measure">
      <h2>Who is building this</h2>
      <p class="chapter-lede">
        EKHO Labs is two founders. We build EKHO in the open and we use it every day for EKHO
        itself: the vault behind this site holds 710 notes, and every decision on this page is one
        of them.
      </p>
    </div>
    <ul class="people">
      {people.map((p) => (
        <li>
          <span class="people-sq" aria-hidden="true"></span>
          <b>{p.name}</b>
          <span>{p.line}</span>
        </li>
      ))}
    </ul>
  </section>

  {/* ---------- 08 · where we are, and the waitlist ---------- */}
  <section
    class="wrap wrap-wide chapter chapter--wide"
    id="waitlist"
    data-chapter
    data-nav="architecture"
    data-stage="3"
  >
    <div class="measure">
      <h2>Where we are</h2>
      <p class="chapter-lede">
        The CLI works and we use it daily. The viewer is in build. There is no hosted product, no
        account and no pricing yet. If you want to be there when there is, leave your mail.
      </p>
      <Waitlist />
    </div>
  </section>

  <div class="wrap wrap-wide landing">
    <p class="closing measure">
      We build EKHO so people can make their context compound, <mark>and keep it theirs.</mark>
    </p>
  </div>
</Base>

<script>
  // Progressive enhancement only. Without JavaScript, or with reduced motion,
  // every statement is fully visible, the graphic rests in its finished state
  // and the architecture stack renders in the state the markup gives it.
  const root = document.documentElement;
  root.classList.add('js');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion) root.classList.add('reveal-on');

  const chapters = [...document.querySelectorAll<HTMLElement>('[data-chapter]')];
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-chapter-link]')].map((a) => [
      a.dataset.chapterLink,
      a,
    ]),
  );
  const sequences = [...document.querySelectorAll<HTMLElement>('[data-seq]')];
  const chapterNav = document.querySelector<HTMLElement>('[data-chapter-nav]');
  const graphics = [...document.querySelectorAll<HTMLElement>('[data-graphic]')];
  const arch = document.querySelector<HTMLElement>('[data-arch]');
  const railRows = [...document.querySelectorAll<HTMLElement>('[data-rail] [data-layer]')];
  const figure = document.querySelector<HTMLElement>('[data-story-figure]');
  let lastNav: string | undefined;

  function update() {
    const vh = window.innerHeight;

    // the chapter whose top has passed a third of the viewport is the one
    // being read; it decides the nav, and which stage the graphic is in
    let current: HTMLElement | undefined;
    for (const c of chapters) if (c.getBoundingClientRect().top <= vh / 3) current = c;

    const nav = current?.dataset.nav;
    links.forEach((a, id) => {
      if (id === nav) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    });

    // on narrow screens the chapter list scrolls sideways: keep the active one in view
    if (chapterNav && nav !== lastNav) {
      lastNav = nav;
      const active = nav ? links.get(nav) : undefined;
      if (active) {
        const navBox = chapterNav.getBoundingClientRect();
        const box = active.getBoundingClientRect();
        if (box.left < navBox.left || box.right > navBox.right) {
          chapterNav.scrollLeft += box.left - navBox.left - 8;
        }
      } else {
        chapterNav.scrollLeft = 0;
      }
    }

    // the windows lie over the graph, one chapter at a time, and the column
    // divider only appears once the two columns start doing different jobs
    if (figure) {
      figure.dataset.show = current?.dataset.overlay ?? '';
      figure.dataset.stage = current?.dataset.stage ?? '0';
    }

    // the architecture rail: one stack for the whole story, moved through its
    // states by whichever chapter is being read
    {
      const on = (current?.dataset.layers ?? '').split(' ').filter(Boolean);
      const done = (current?.dataset.done ?? '').split(' ').filter(Boolean);
      for (const r of railRows) {
        const k = r.dataset.layer ?? '';
        const isOn = on.includes(k);
        r.classList.toggle('is-on', isOn);
        r.classList.toggle('is-done', !isOn && done.includes(k));
        r.classList.toggle('is-off', !isOn && !done.includes(k));
      }
    }

    // the graphic: 0 field, 1 scattered, 2 connected, 3 compounding
    {
      const stage = Number(current?.dataset.stage ?? 0);
      for (const g of graphics)
        for (let n = 1; n <= 3; n++) g.classList.toggle(`is-${n}`, stage >= n);
    }

    // architecture: its rows come in once the chapter is in view
    if (arch && arch.getBoundingClientRect().top < vh * 0.8) arch.classList.add('is-in');

    // statement sequences: the step nearest the reading line is full, the rest dim
    const line = vh * 0.45;
    for (const seq of sequences) {
      const steps = [...seq.querySelectorAll<HTMLElement>('[data-step]')];
      let best: HTMLElement | undefined;
      let bestDist = Infinity;
      for (const s of steps) {
        const r = s.getBoundingClientRect();
        const dist = Math.abs(r.top + r.height / 2 - line);
        if (dist < bestDist) {
          bestDist = dist;
          best = s;
        }
      }
      for (const s of steps) s.classList.toggle('is-current', s === best);
    }
  }

  let queued = false;
  function onScroll() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      update();
    });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  update();
</script>
