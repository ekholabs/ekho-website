---
import Base from '../layouts/Base.astro';

const chapters = [
  { id: 'context', n: '01', label: 'Context' },
  { id: 'why', n: '02', label: 'Why' },
  { id: 'how', n: '03', label: 'How' },
  { id: 'yours', n: '04', label: 'Yours' },
  { id: 'not-yet', n: '05', label: 'Not yet' },
];
---

<Base
  title="EKHO Labs — AI is only as good as your context"
  description="EKHO turns what you know into connected context that compounds, so you get more out of AI every time you use it, and it stays yours."
  layout="wide"
>
  <div class="scene" data-scene style="--phrases: 2">
    <div class="wrap wrap-wide scene-frame">
      <h1 class="scene-text scene-text--lead">
        <span class="phrase" data-phrase>
          AI is only as good as your context.
        </span>
        <span class="phrase" data-phrase>
          Own it!
        </span>
      </h1>
    </div>
  </div>

  <div class="scene" data-scene style="--phrases: 3">
    <div class="wrap wrap-wide scene-frame">
      <p class="scene-text">
        <span class="phrase" data-phrase>
          The model is the same for everyone.
        </span>
        <span class="phrase" data-phrase>
          What makes it work for you is your context:
        </span>
        <span class="phrase" data-phrase>
          what you know, what you have decided, and why.
        </span>
      </p>
    </div>
  </div>

  <div class="scene" data-scene style="--phrases: 3">
    <div class="wrap wrap-wide scene-frame">
      <p class="scene-text">
        <span class="phrase" data-phrase>
          Most of it lives in your head,
        </span>
        <span class="phrase" data-phrase>
          and every chat forgets it.
        </span>
        <span class="phrase" data-phrase>
          So you explain it again, or you settle for a generic answer.
        </span>
      </p>
    </div>
  </div>

  <div class="scene" data-scene style="--phrases: 3">
    <div class="wrap wrap-wide scene-frame">
      <p class="scene-text">
        <span class="phrase" data-phrase>
          EKHO lets you capture it once
        </span>
        <span class="phrase" data-phrase>
          and make it compound.
        </span>
        <span class="phrase" data-phrase>
          Every time you use AI, you get more out of it than the time before.
        </span>
      </p>
    </div>
  </div>

  <div class="scene" data-scene style="--phrases: 2">
    <div class="wrap wrap-wide scene-frame">
      <p class="scene-text">
        <span class="phrase" data-phrase>
          And because your context is what makes AI valuable to you,
        </span>
        <span class="phrase" data-phrase>
          <mark>it has to stay yours.</mark>
        </span>
      </p>
    </div>
  </div>

  <nav class="chapter-nav" aria-label="Chapters">
    <div class="wrap wrap-wide">
      <ol>
        {chapters.map((c) => (
          <li>
            <a href={`#${c.id}`} data-chapter-link={c.id}>
              <span class="chapter-nav-n">{c.n}</span>
              {c.label}
            </a>
          </li>
        ))}
      </ol>
    </div>
  </nav>

  <div class="wrap wrap-wide landing">
    <section class="chapter measure" id="context" data-chapter>
      <p class="chapter-label">
        <span>01</span> Context
      </p>
      <h2>What context is</h2>
      <div data-seq>
        <p class="statement" data-step>
          Context is everything an AI would need to know to answer the way you would, if you had the
          time to explain. Your situation, your goals, what you have already decided and why, what
          you have read and what you concluded from it.
        </p>
        <p class="statement" data-step>
          The model brings intelligence. It is the same for everyone. You bring context. It exists
          only with you.
        </p>
        <p class="statement" data-step>
          The context window is where context gets used. EKHO is where it lives.
        </p>
      </div>
    </section>

    <section class="chapter measure" id="why" data-chapter>
      <p class="chapter-label">
        <span>02</span> Why
      </p>
      <h2>Why context matters</h2>
      <ol class="cards" data-seq>
        <li class="card" data-step>
          <h3>Everyone has the same models. Nobody has your context.</h3>
          <p>
            As intelligence gets cheap, context is what separates a generic answer from one that
            actually helps you. It is the part of AI you control.
          </p>
        </li>
        <li class="card" data-step>
          <h3>Most of it is implicit, or scattered.</h3>
          <p>
            In your head, in chats that close, in mails, meetings and notes that know nothing of
            each other. So every session starts near zero.
          </p>
        </li>
        <li class="card" data-step>
          <h3>Connected, context compounds.</h3>
          <p>
            EKHO turns what was scattered into one highly connected source: every insight knows
            where it came from, what supports it and what contradicts it. Each new piece links to
            everything already there.
          </p>
        </li>
        <li class="card" data-step>
          <h3>An asset needs an owner.</h3>
          <p>
            If your context decides how much AI does for you, it has to stay yours. Not locked in a
            model provider's memory.
          </p>
        </li>
      </ol>
    </section>

    <section class="chapter measure" id="how" data-chapter>
      <p class="chapter-label">
        <span>03</span> How
      </p>
      <h2>How it works</h2>
      <p>
        <strong>AI does the bookkeeping.</strong> You bring in what comes up: a meeting, an article,
        a voice note. An agent condenses it, links it to what you already have, and marks what
        confirms or contradicts what. Your knowledge is sorted before you ask, not searched for when
        you do. Keeping it up costs almost nothing, which is why it compounds instead of gathering
        dust.
      </p>
      <p>Throw it in, let it be digested, ask.</p>
    </section>

    <section class="chapter measure" id="yours" data-chapter>
      <p class="chapter-label">
        <span>04</span> Yours
      </p>
      <h2>What it is</h2>
      <p>
        A folder of plain Markdown files that belongs to you and that you can take anywhere. The
        <code>ekho</code> command-line tool maintains it with the coding agent of your choice, such
        as Claude Code, Codex or OpenCode. You read the files, your AI reads the same ones.
      </p>
      <p>
        <strong>A standard that is enforced, not just written down.</strong> Your context lives in
        an open, typed format, and a linter keeps the agent in line whichever model is running. The
        model is replaceable. Your context stays with you.
      </p>
    </section>

    <section class="chapter measure" id="not-yet" data-chapter>
      <p class="chapter-label">
        <span>05</span> Not yet
      </p>
      <h2>What does not exist yet</h2>
      <ul>
        <li>No web interface. You work in your editor and your terminal, and read in Obsidian.</li>
        <li>
          No automatic import. Mail, chat and calendar are not connected; you bring things in.
        </li>
        <li>No built-in sharing between people yet.</li>
        <li>EKHO takes over the bookkeeping, not your judgement.</li>
      </ul>

      <h2>Install</h2>
      <pre><code>curl -fsSL https://get.ekholabs.eu/i/&lt;key&gt; | sh</code></pre>
      <p class="note">
        EKHO is in early access, by invitation. This installer is not available yet.
      </p>
    </section>

    <p class="closing measure">
      We build EKHO so people can make their context compound, <mark>and keep it theirs.</mark>
    </p>
  </div>
</Base>

<script>
  // Deck-style reveal and chapter navigation. Progressive enhancement only:
  // without JavaScript, or with reduced motion, every phrase is fully visible
  // and the scenes take no extra scroll room.
  const root = document.documentElement;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion) root.classList.add('reveal-on');

  const scenes = [...document.querySelectorAll<HTMLElement>('[data-scene]')];
  const chapters = [...document.querySelectorAll<HTMLElement>('[data-chapter]')];
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-chapter-link]')].map((a) => [
      a.dataset.chapterLink,
      a,
    ]),
  );
  const sequences = [...document.querySelectorAll<HTMLElement>('[data-seq]')];

  function update() {
    const vh = window.innerHeight;

    // scenes: one statement per screen; while the statement stays in place,
    // the highlight moves from phrase to phrase as the scene scrolls past
    if (!reduceMotion) {
      for (const scene of scenes) {
        const phrases = [...scene.querySelectorAll<HTMLElement>('[data-phrase]')];
        const scrollable = scene.offsetHeight - vh;
        const r = scene.getBoundingClientRect();
        const progress = scrollable > 0 ? Math.min(1, Math.max(0, -r.top / scrollable)) : 0;
        const current = Math.min(phrases.length - 1, Math.floor(progress * phrases.length));
        phrases.forEach((p, i) => p.classList.toggle('is-current', i === current));
      }
    }

    // chapter nav: the chapter whose top has passed a third of the viewport
    let currentChapter: string | undefined;
    for (const c of chapters) if (c.getBoundingClientRect().top <= vh / 3) currentChapter = c.id;
    links.forEach((a, id) => {
      if (id === currentChapter) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    });

    // statement sequences: the step nearest the reading line is full, the rest dim
    const line = vh * 0.45;
    for (const seq of sequences) {
      const steps = [...seq.querySelectorAll<HTMLElement>('[data-step]')];
      let best: HTMLElement | undefined;
      let bestDist = Infinity;
      for (const s of steps) {
        const r = s.getBoundingClientRect();
        const dist = Math.abs(r.top + r.height / 2 - line);
        if (dist < bestDist) {
          bestDist = dist;
          best = s;
        }
      }
      for (const s of steps) s.classList.toggle('is-current', s === best);
    }
  }

  let queued = false;
  function onScroll() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      update();
    });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  update();
</script>
